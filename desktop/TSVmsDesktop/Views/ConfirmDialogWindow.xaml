<Window x:Class="TSVmsDesktop.Views.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Height="240"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#171717">
    <Border Padding="16">
        <Border Background="#2B2B2E" BorderBrush="#4A4A4F" BorderThickness="1" CornerRadius="16" Padding="18">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.25"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText"
                           Text="Confirm"
                           Foreground="#F2F2F2"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock Grid.Row="1"
                           x:Name="MessageText"
                           Margin="0,10,0,14"
                           TextWrapping="Wrap"
                           Foreground="#D4D4D8"
                           FontSize="14"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="No"
                            IsCancel="True"
                            Width="90"
                            Height="36"
                            Margin="0,0,10,0"
                            Style="{StaticResource OutlineButtonStyle}"
                            Foreground="#D4D4D8"
                            BorderBrush="#4A4A4F"/>
                    <Button Content="Yes"
                            Width="90"
                            Height="36"
                            IsDefault="True"
                            Click="Yes_Click"
                            Style="{StaticResource PillButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
