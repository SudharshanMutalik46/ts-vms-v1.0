<Window x:Class="TSVmsDesktop.Views.AdoptionPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TSVmsDesktop.Controls"
        Title="Camera Preview"
        Height="620"
        Width="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#171717"
        WindowStyle="SingleBorderWindow">
        <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Camera Adopted Successfully"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#F2F2F2"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0F1115" BorderBrush="#2E3540" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,12,0">
                <Grid>
                    <controls:VideoCanvas x:Name="PreviewVideoCanvas" Visibility="Collapsed"/>
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    <TextBlock x:Name="PreviewPlaceholderText"
                               Text="Preview not available for this camera."
                               Foreground="#B8B8BC"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#2B2B2E" BorderBrush="#4A4A4F" BorderThickness="1" CornerRadius="12" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Camera Details" FontSize="16" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,0,0,10"/>
                        <TextBlock x:Name="DetailsText" TextWrapping="Wrap" Foreground="#D4D4D8" FontSize="13"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#2B2B2E" BorderBrush="#4A4A4F" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="RTSP URL (Editable)" Foreground="#D4D4D8" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="RtspUrlBox" Height="36" Foreground="#F2F2F2" Background="#3A3A3D" BorderBrush="#4A4A4F" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="RetryStatusText" Foreground="#B8B8BC" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="RetryButton" Content="Retry" Width="96" Height="36" Margin="12,20,0,0"
                        Foreground="White" Background="#2F8F4E" BorderBrush="#46B96A" BorderThickness="1"
                        Click="Retry_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Stay Here" Width="110" Height="36" Margin="0,0,10,0"
                    Foreground="#D4D4D8" Background="#2D3138" BorderBrush="#4A4A4F" BorderThickness="1"
                    Click="Stay_Click"/>
            <Button Content="Open Live View" Width="130" Height="36"
                    Foreground="White" Background="#EA7A00" BorderBrush="#EA7A00" BorderThickness="1"
                    Click="OpenLive_Click"/>
        </StackPanel>
    </Grid>
</Window>
