<UserControl x:Class="TSVmsDesktop.Views.CamerasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="InventoryPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="InventorySecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Background" Value="#34353A"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderBrush" Value="#4A4A4F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3E44"/>
                    <Setter Property="BorderBrush" Value="#6B7280"/>
                    <Setter Property="Foreground" Value="#F2F2F2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InventoryTileStyle" TargetType="Border">
            <Setter Property="Background" Value="#2B2B2E"/>
            <Setter Property="BorderBrush" Value="#4A4A4F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#4A4A4F"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3A3A3D"/>
            <Setter Property="Background" Value="#2B2B2E"/>
            <Setter Property="RowBackground" Value="#2B2B2E"/>
            <Setter Property="AlternatingRowBackground" Value="#323236"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Extended"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackground}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource InventoryTileStyle}">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="3" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Inventory" FontSize="28" FontWeight="Bold" Foreground="#F2F2F2"/>
                    <TextBlock Text="Manage camera sources, enable or disable selected items, and open discovery from one place."
                               FontSize="12" Foreground="#B8B8BC" Margin="0,4,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" ItemHeight="40">
                    <Button Command="{Binding AddCameraCommand}" Content="+ Add Camera" Style="{StaticResource InventoryPrimaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Command="{Binding OpenDiscoveryCommand}" Content="Discover" Style="{StaticResource InventoryPrimaryButtonStyle}" Background="#2196F3" Margin="0,0,10,0"/>
                    <Button Command="{Binding EnableSelectedCommand}" Content="Enable" Style="{StaticResource InventorySecondaryButtonStyle}" Margin="0,0,10,0" Foreground="#2E7D32" BorderBrush="#2E7D32"/>
                    <Button Command="{Binding DisableSelectedCommand}" Content="Disable" Style="{StaticResource InventorySecondaryButtonStyle}" Margin="0,0,10,0" Foreground="#C62828" BorderBrush="#C62828"/>
                    <Button Command="{Binding RefreshListCommand}" Content="Refresh" Style="{StaticResource InventorySecondaryButtonStyle}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource InventoryTileStyle}" Padding="8" Margin="0,18,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="3" Opacity="0.06"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding Cameras}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      RowHeight="50"
                      Background="#2B2B2E"
                      Foreground="#F2F2F2"
                      HorizontalGridLinesBrush="#3A3A3D"
                      VerticalGridLinesBrush="#3A3A3D"
                      RowBackground="#2B2B2E"
                      AlternatingRowBackground="#323236"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      AlternationCount="2">
                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=RowBackground}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=AlternatingRowBackground}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3F3F44"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="12,0" Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3F3F44"/>
                                <Setter Property="Foreground" Value="#FF8A1F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Select" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ModernCheckBox}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="250" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="180"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="150"/>

                    <DataGridTemplateColumn Header="Status" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                            <Setter Property="Background" Value="#1F3428"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                    <Setter Property="Background" Value="#3A2323"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                    <Setter Property="Background" Value="#3A2E1F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Checking...">
                                                    <Setter Property="Background" Value="#3A3A3D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#31C776"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                        <Setter Property="Foreground" Value="#F06A6A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                        <Setter Property="Foreground" Value="#FFB347"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Checking...">
                                                        <Setter Property="Foreground" Value="#B8B8BC"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Actions" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Details"
                                            Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource InventorySecondaryButtonStyle}"
                                            Foreground="#A8C5E6"
                                            BorderBrush="#475569"
                                            Height="32"
                                            FontSize="12"
                                            Padding="14,0"
                                            MinWidth="90"/>

                                    <Button Command="{Binding DataContext.DeleteCameraCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="10,0,0,0"
                                            Style="{StaticResource InventorySecondaryButtonStyle}"
                                            Foreground="#B91C1C"
                                            BorderBrush="#7F1D1D"
                                            Height="32"
                                            Width="82"
                                            Padding="0"
                                            ToolTip="Delete Camera">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" CornerRadius="16">
                                                    <TextBlock Text="Delete" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                               Foreground="#B91C1C" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
