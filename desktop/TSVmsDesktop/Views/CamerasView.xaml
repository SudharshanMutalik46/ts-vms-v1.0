<UserControl x:Class="TSVmsDesktop.Views.CamerasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TSVmsDesktop.ViewModels">

    <Grid Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel Margin="0,0,0,20">

                <Grid Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="Camera Management" FontSize="26" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="Add, edit, and configure video sources" FontSize="14" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button Command="{Binding AddCameraCommand}" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{StaticResource TechnoOrange}" CornerRadius="20" Padding="20,10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#E65100" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" FontSize="16"/>
                                        <TextBlock Text="Add Camera" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#CC4600"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding Cameras}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="12" Margin="0,0,0,12" Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect Color="#DDD" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>  <ColumnDefinition Width="*"/>   <ColumnDefinition Width="150"/> <ColumnDefinition Width="120"/> <ColumnDefinition Width="100"/> </Grid.ColumnDefinitions>

                                    <Border Background="#F5F7FA" Width="45" Height="45" CornerRadius="8">
                                        <TextBlock Text="📹" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#333" FontSize="15"/>
                                        <TextBlock Text="{Binding Model}" Foreground="#999" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Text="🌐 " Foreground="#CCC" FontSize="12"/>
                                        <TextBlock Text="{Binding IpAddress}" Foreground="#666" FontSize="13" FontFamily="Consolas"/>
                                    </StackPanel>

                                    <Border Grid.Column="3" CornerRadius="12" Padding="12,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8F5E9"/> <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                        <Setter Property="Background" Value="#FFEBEE"/> </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                        <Setter Property="Background" Value="#FFF3E0"/> </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2E7D32"/> <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                            <Setter Property="Foreground" Value="#C62828"/> </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter Property="Foreground" Value="#EF6C00"/> </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Background="Transparent" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                                            <TextBlock Text="✎" Foreground="#AAA" FontSize="16"/>
                                        </Button>
                                        
                                        <Button Command="{Binding DataContext.DeleteCameraCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <TextBlock Text="🗑" Foreground="#FF8A80" FontSize="16"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
