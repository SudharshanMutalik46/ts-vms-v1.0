<UserControl x:Class="TSVmsDesktop.Views.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:TSVmsDesktop.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ModernPlaybackCardStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#13263F" Offset="0"/>
                        <GradientStop Color="#0E1D31" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#2A4467"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>

        <Style x:Key="ModernPlaybackButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#D5E7FF"/>
            <Setter Property="Background" Value="#1A3556"/>
            <Setter Property="BorderBrush" Value="#2A4D78"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24456D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A78AC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D395B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPlaybackPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ModernPlaybackButtonStyle}">
            <Setter Property="Background" Value="#F58A28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#DD7416"/>
        </Style>

        <Style x:Key="ModernRateChipStyle"
               TargetType="Button"
               BasedOn="{StaticResource ModernPlaybackButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#112A45"/>
            <Setter Property="BorderBrush" Value="#355986"/>
            <Setter Property="Foreground" Value="#BFD8F6"/>
        </Style>

        <Style x:Key="TimelineIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ModernPlaybackButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TimelineRoundControlButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TimelineIconButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24456D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A78AC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D395B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaybackLaneLabelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="ModernTimelineSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="2" Cursor="SizeWE">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid x:Name="ThumbVisual" Background="Transparent">
                                                    <!-- Vertical Line -->
                                                    <Border Width="2" Height="52" Background="#F58A28" VerticalAlignment="Center"/>
                                                    <!-- Circle Handle -->
                                                    <Ellipse Width="12" Height="12" Fill="#F58A28" Stroke="#FFCF99" StrokeThickness="1.4" VerticalAlignment="Center" Margin="0,-1,0,1"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaybackShellCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="PlaybackTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="PlaybackMetaStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9DB7D7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="PlaybackMiniButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="PlaybackLayoutButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#E0F2FE"/>
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#081423" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="182"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Background="#0D1B2D">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0F2138"
                    BorderThickness="0"
                    CornerRadius="0"
                    Padding="12,8,8,8">
                <StackPanel>
                    <TextBlock Text="Common"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#DCEAFE"/>
                    <DatePicker Margin="0,10,0,0"
                                SelectedDate="{Binding SelectedDayLocal, Mode=TwoWay}"
                                SelectedDateFormat="Short"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="#0F2138"
                    BorderThickness="0"
                    CornerRadius="0"
                    Padding="12,8,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Playback Cameras"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#E2EEFF"/>
                        <TextBlock Text="Select up to 4 cameras to review archived footage."
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PlaybackMetaStyle}"/>
                        <TextBlock Text="Tick the checkboxes to select up to 4 cameras."
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PlaybackMetaStyle}"/>
                    </StackPanel>

                    <TextBox Grid.Row="2"
                             Height="36"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding CameraSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="#D8E9FF"
                             Background="#102640"
                             BorderThickness="0"/>

                    <ListBox x:Name="PlaybackCameraList"
                             Grid.Row="4"
                             ItemsSource="{Binding AvailablePlaybackCameras}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="#132A44"
                                                    BorderThickness="0"
                                                    CornerRadius="0"
                                                    Padding="12,10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#4A78AC"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Checked="PlaybackCameraCheckBox_Changed"
                                          Unchecked="PlaybackCameraCheckBox_Changed"
                                          FontWeight="SemiBold"
                                          Foreground="#DCEAFE"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Fallback placeholder -->
                    <TextBlock Grid.Row="4" 
                               Text="No cameras found" 
                               Foreground="#94A3B8" 
                               FontSize="13" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                           <Style TargetType="TextBlock">
                               <Setter Property="Visibility" Value="Collapsed"/>
                               <Style.Triggers>
                                   <DataTrigger Binding="{Binding AvailablePlaybackCameras.Count}" Value="0">
                                       <Setter Property="Visibility" Value="Visible"/>
                                   </DataTrigger>
                               </Style.Triggers>
                           </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Grid.Row="6"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0"
                            Padding="10"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Export Clip"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#E2EEFF"/>

                            <TextBox Height="32"
                                     Margin="0,8,0,0"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ExportStartLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>

                            <TextBox Height="32"
                                     Margin="0,8,0,0"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ExportEndLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>

                            <Button Content="Export Range"
                                    Height="34"
                                    Foreground="#DCEAFE"
                                    Background="#1A3556"
                                    BorderThickness="0"
                                    Margin="0,8,0,0"
                                    Command="{Binding ExportRangeCommand}"/>

                            <TextBlock Text="{Binding LastExportDisplay}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource PlaybackMetaStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

            <Grid Grid.Row="0" Grid.Column="2" x:Name="PlaybackContentGrid" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="PlaybackTopBar"
                            Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,0"
                            Visibility="Collapsed">
                    <ToggleButton Style="{StaticResource PlaybackLayoutButtonStyle}"
                                  IsChecked="{Binding IsSingleViewSelected, Mode=OneWay}"
                                  Command="{Binding SetSinglePlaybackLayoutCommand}"
                                  ToolTip="Single View"
                                  Content="&#xE8A7;"/>

                    <ToggleButton Style="{StaticResource PlaybackLayoutButtonStyle}"
                                  IsChecked="{Binding IsQuadViewSelected, Mode=OneWay}"
                                  Command="{Binding SetQuadPlaybackLayoutCommand}"
                                  ToolTip="Quad View"
                                  Content="&#xECA5;"/>
                </StackPanel>

                <Border x:Name="PlaybackStage"
                    Grid.Row="1"
                    Background="Transparent"
                    Padding="0"
                    CornerRadius="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ClipToBounds="True">
                <Grid x:Name="PlaybackViewport" Background="Transparent" ClipToBounds="True">
                    <Grid Margin="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="PlaybackTile1" Grid.Row="0" Grid.Column="0" Margin="2" Background="#000000" BorderThickness="0">
                            <Grid>
                                <controls:VideoCanvas x:Name="PlaybackHost1"
                                                      Tag="0"
                                                      Loaded="PlaybackTileHost_Loaded"
                                                      SizeChanged="PlaybackTileHost_SizeChanged"
                                                      MinWidth="64"
                                                      MinHeight="64"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12">
                                    <TextBlock Text="{Binding PlaybackSlots[0].CameraName}" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PlaybackSlots[0].StatusText}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Foreground="#CBD5E1"/>

                                <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16,10" Background="#CC000000" CornerRadius="12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlaybackSlots[0].StatusText}" Value="No recording at selected time">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PlaybackSlots[0].StatusText}" Value="No recording in selected window">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding PlaybackSlots[0].StatusText}" Foreground="#F87171" FontWeight="SemiBold" FontSize="14" MaxWidth="280" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border x:Name="PlaybackTile2" Grid.Row="0" Grid.Column="1" Margin="2" Background="#000000" BorderThickness="0">
                            <Grid>
                                <controls:VideoCanvas x:Name="PlaybackHost2"
                                                      Tag="1"
                                                      Loaded="PlaybackTileHost_Loaded"
                                                      SizeChanged="PlaybackTileHost_SizeChanged"
                                                      MinWidth="64"
                                                      MinHeight="64"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12">
                                    <TextBlock Text="{Binding PlaybackSlots[1].CameraName}" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PlaybackSlots[1].StatusText}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Foreground="#CBD5E1"/>

                                <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16,10" Background="#CC000000" CornerRadius="12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlaybackSlots[1].StatusText}" Value="No recording at selected time">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PlaybackSlots[1].StatusText}" Value="No recording in selected window">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding PlaybackSlots[1].StatusText}" Foreground="#F87171" FontWeight="SemiBold" FontSize="14" MaxWidth="280" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border x:Name="PlaybackTile3" Grid.Row="1" Grid.Column="0" Margin="2" Background="#000000" BorderThickness="0">
                            <Grid>
                                <controls:VideoCanvas x:Name="PlaybackHost3"
                                                      Tag="2"
                                                      Loaded="PlaybackTileHost_Loaded"
                                                      SizeChanged="PlaybackTileHost_SizeChanged"
                                                      MinWidth="64"
                                                      MinHeight="64"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12">
                                    <TextBlock Text="{Binding PlaybackSlots[2].CameraName}" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PlaybackSlots[2].StatusText}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Foreground="#CBD5E1"/>

                                <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16,10" Background="#CC000000" CornerRadius="12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlaybackSlots[2].StatusText}" Value="No recording at selected time">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PlaybackSlots[2].StatusText}" Value="No recording in selected window">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding PlaybackSlots[2].StatusText}" Foreground="#F87171" FontWeight="SemiBold" FontSize="14" MaxWidth="280" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border x:Name="PlaybackTile4" Grid.Row="1" Grid.Column="1" Margin="2" Background="#000000" BorderThickness="0">
                            <Grid>
                                <controls:VideoCanvas x:Name="PlaybackHost4"
                                                      Tag="3"
                                                      Loaded="PlaybackTileHost_Loaded"
                                                      SizeChanged="PlaybackTileHost_SizeChanged"
                                                      MinWidth="64"
                                                      MinHeight="64"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12">
                                    <TextBlock Text="{Binding PlaybackSlots[3].CameraName}" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PlaybackSlots[3].StatusText}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Foreground="#CBD5E1"/>

                                <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16,10" Background="#CC000000" CornerRadius="12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlaybackSlots[3].StatusText}" Value="No recording at selected time">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PlaybackSlots[3].StatusText}" Value="No recording in selected window">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding PlaybackSlots[3].StatusText}" Foreground="#F87171" FontWeight="SemiBold" FontSize="14" MaxWidth="280" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,14,14,0"
                            Padding="12,10"
                            Background="#CCFFFFFF"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="{Binding CoverageSummaryText}"
                                       Foreground="#334155"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding WindowSummaryText}"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource PlaybackMetaStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,14,220,0"
                            Padding="8,6"
                            Background="#CCFFFFFF"
                            CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource PlaybackLayoutButtonStyle}"
                                          IsChecked="{Binding IsSingleViewSelected, Mode=OneWay}"
                                          Command="{Binding SetSinglePlaybackLayoutCommand}"
                                          ToolTip="Single View"
                                          Content="&#xE8A7;"/>

                            <ToggleButton Style="{StaticResource PlaybackLayoutButtonStyle}"
                                          IsChecked="{Binding IsQuadViewSelected, Mode=OneWay}"
                                          Command="{Binding SetQuadPlaybackLayoutCommand}"
                                          ToolTip="Quad View"
                                          Content="&#xECA5;"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#BF020617"
                            Visibility="{Binding ShowPlayerOverlay, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                            <TextBlock Text="{Binding PlayerOverlayTitle}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock Text="{Binding PlayerOverlaySubtitle}"
                                       Margin="0,10,0,0"
                                       Foreground="#CBD5E1"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>



        </Grid>

        <Border x:Name="PlaybackTimelinePanel"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Background="Transparent"
                    Padding="2,2,2,2"
                    MinHeight="150">
                <Border Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Padding="10,8,10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- Top row -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="|&lt;"
                                        Command="{Binding PreviousCommand}"
                                        Style="{StaticResource TimelineRoundControlButtonStyle}"/>

                                <Button Content="&lt;&lt;"
                                        Command="{Binding SeekBackCommand}"
                                        Style="{StaticResource TimelineRoundControlButtonStyle}"/>

                                <Button Content="Play/Pause"
                                        Command="{Binding TogglePlayPauseCommand}"
                                        IsEnabled="{Binding HasSegments}"
                                        Style="{StaticResource ModernPlaybackPrimaryButtonStyle}"
                                        MinWidth="108"/>

                                <Button Content="Stop"
                                        Command="{Binding StopPlaybackCommand}"
                                        IsEnabled="{Binding HasMediaLoaded}"
                                        Style="{StaticResource ModernPlaybackButtonStyle}"
                                        MinWidth="64"/>

                                <Button Content="&gt;&gt;"
                                        Command="{Binding SeekForwardCommand}"
                                        Style="{StaticResource TimelineRoundControlButtonStyle}"/>

                                <Button Content="&gt;|"
                                        Command="{Binding NextCommand}"
                                        Style="{StaticResource TimelineRoundControlButtonStyle}"/>

                                <Border Width="1" Height="20" Background="#2A4467" Margin="8,0,12,0"/>

                                <Button Content="1x"
                                        Command="{Binding SetRate1xCommand}"
                                        IsEnabled="{Binding HasMediaLoaded}"
                                        Style="{StaticResource ModernRateChipStyle}"
                                        MinWidth="54"/>

                                <Button Content="2x"
                                        Command="{Binding SetRate2xCommand}"
                                        IsEnabled="{Binding HasMediaLoaded}"
                                        Style="{StaticResource ModernRateChipStyle}"/>

                                <Button Content="4x"
                                        Command="{Binding SetRate4xCommand}"
                                        IsEnabled="{Binding HasMediaLoaded}"
                                        Style="{StaticResource ModernRateChipStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,6,0"/>
                                    <TextBlock Text="Motion" Foreground="#A8C2DF" FontSize="12" Margin="0,0,16,0"/>
                                    <Ellipse Width="8" Height="8" Fill="#F58A28" Margin="0,0,6,0"/>
                                    <TextBlock Text="Event" Foreground="#A8C2DF" FontSize="12"/>
                                </StackPanel>

                                <Border Width="1" Height="20" Background="#2A4467" Margin="12,0,10,0"/>
                                <Button Content="&#xE722;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TimelineIconButtonStyle}" ToolTip="Zoom Out" Command="{Binding ZoomTimelineOutCommand}"/>
                                <Button Content="&#xE71E;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TimelineIconButtonStyle}" ToolTip="Zoom In" Command="{Binding ZoomTimelineInCommand}"/>
                                <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TimelineIconButtonStyle}" ToolTip="Fit" Command="{Binding FitTimelineCommand}"/>
                                <Button Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TimelineIconButtonStyle}" ToolTip="Snapshot"/>
                            </StackPanel>
                        </Grid>

                        <!-- Integrated playback lanes: compact strip style -->
                        <Border Grid.Row="2"
                                Background="#0F2138"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="0,2,0,3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="2"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="Transparent"
                                        Padding="132,2,24,2"
                                        Margin="0,0,0,0">
                                    <ItemsControl ItemsSource="{Binding TimelineTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Height="24"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding LeftPx}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Border Width="1"
                                                            Height="5"
                                                            Background="#6489B7"
                                                            HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="11"
                                                               Foreground="#95B6D8"
                                                               Margin="-12,2,0,0">
                                                        <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Margin" Value="-12,2,0,0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRightEdge}" Value="True">
                                                                        <Setter Property="Margin" Value="-52,2,0,0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <ItemsControl Grid.Row="2" ItemsSource="{Binding PlaybackTimelines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4"
                                                  Height="24"
                                                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="124"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding CameraName}"
                                                           Foreground="#C9DDF8"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"/>

                                                <Border Grid.Column="1"
                                                        x:Name="TimelineHost"
                                                        Background="Transparent"
                                                        Tag="{Binding SlotIndex}"
                                                        Padding="6,2,6,2"
                                                        SizeChanged="PlaybackTimelineHost_OnSizeChanged"
                                                        MouseLeftButtonDown="TimelineHost_MouseLeftButtonDown"
                                                        MouseMove="TimelineHost_MouseMove"
                                                        MouseLeftButtonUp="TimelineHost_MouseLeftButtonUp"
                                                        MouseWheel="TimelineHost_MouseWheel">
                                                    <Grid>
                                                        <Border Height="14"
                                                                VerticalAlignment="Center"
                                                                Background="#1A2F48"
                                                                CornerRadius="2"/>

                                                        <ItemsControl ItemsSource="{Binding Segments}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas Height="14"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding LeftPx}"/>
                                                                    <Setter Property="Canvas.Top" Value="0"/>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <Border Width="{Binding WidthPx}"
                                                                                Height="14"
                                                                                Background="#1FA34A"
                                                                                BorderBrush="#157A38"
                                                                                BorderThickness="0.8"/>
                                                                        <Border Width="2"
                                                                                Height="14"
                                                                                Background="#F5A33A"
                                                                                HorizontalAlignment="Left"
                                                                                Visibility="Collapsed">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasGapBefore}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Canvas Grid.RowSpan="3"
                                        IsHitTestVisible="False"
                                        Margin="132,0,24,0">
                                    <Border Canvas.Left="{Binding PlayheadLeftPx}"
                                            Canvas.Top="8"
                                            Background="#F58A28"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            Visibility="{Binding IsTimelineScrubbing, Converter={StaticResource BoolToVis}}">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="-18"/>
                                        </Border.RenderTransform>
                                        <TextBlock Text="{Binding ScrubPreviewTimeText}"
                                                   Foreground="White"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Canvas.Left="{Binding PlayheadLeftPx}"
                                            Canvas.Top="34"
                                            Width="2"
                                            Height="130"
                                            Background="#F58A28">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="-1"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <Ellipse Canvas.Left="{Binding PlayheadLeftPx}"
                                             Canvas.Top="30"
                                             Width="6"
                                             Height="6"
                                             Fill="#F58A28">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="-3"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Canvas>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>
        </Border>
    </Grid>
</UserControl>
