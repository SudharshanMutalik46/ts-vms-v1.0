<UserControl x:Class="TSVmsDesktop.Views.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:TSVmsDesktop.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PlaybackShellCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="PlaybackTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="PlaybackMetaStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="PlaybackMiniButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent" Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="182"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="Transparent"
                    CornerRadius="0"
                    Padding="12,8,8,8">
                <StackPanel>
                    <TextBlock Text="Common"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                    <DatePicker Margin="0,10,0,0"
                                SelectedDate="{Binding SelectedDayLocal, Mode=TwoWay}"
                                SelectedDateFormat="Short"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="Transparent"
                    CornerRadius="0"
                    Padding="12,8,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Playback Cameras"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Select a device to review archived footage."
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PlaybackMetaStyle}"/>
                    </StackPanel>

                    <TextBox Grid.Row="2"
                             Height="36"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding CameraSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#F8FAFC"
                             BorderBrush="#E2E8F0"
                             BorderThickness="1"/>

                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding AvailableCameras}"
                             SelectedItem="{Binding SelectedCamera}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12,10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E0F2FE"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding IpAddress}"
                                               Margin="0,3,0,0"
                                               Style="{StaticResource PlaybackMetaStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

            <Grid Grid.Column="2" x:Name="PlaybackContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

            <Border x:Name="PlaybackStage"
                    Grid.Row="0"
                    Background="#030712"
                    Padding="0"
                    CornerRadius="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    ClipToBounds="True">
                <Grid x:Name="PlaybackViewport" Background="#030712" ClipToBounds="True">
                    <Border x:Name="PlaybackHostFrame"
                            Background="Black"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ClipToBounds="True">
                        <Grid>
                            <controls:VideoCanvas x:Name="PlaybackHost"
                                                  MinWidth="64"
                                                  MinHeight="64"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"/>

                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,14,14,0"
                                    Padding="12,10"
                                    Background="#CCFFFFFF"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding CoverageSummaryText}"
                                               Foreground="#334155"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding WindowSummaryText}"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource PlaybackMetaStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#BF020617"
                                    Visibility="{Binding ShowPlayerOverlay, Converter={StaticResource BoolToVis}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                                    <TextBlock Text="{Binding PlayerOverlayTitle}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="{Binding PlayerOverlaySubtitle}"
                                               Margin="0,10,0,0"
                                               Foreground="#CBD5E1"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="Transparent"
                    CornerRadius="0"
                    Padding="8,4,8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel VerticalAlignment="Center">
                        <Button Content="Play"
                                Command="{Binding TogglePlayPauseCommand}"
                                IsEnabled="{Binding HasSegments}"
                                Style="{StaticResource PlaybackMiniButtonStyle}"/>
                        <Button Content="Stop"
                                Command="{Binding StopPlaybackCommand}"
                                IsEnabled="{Binding HasMediaLoaded}"
                                Style="{StaticResource PlaybackMiniButtonStyle}"/>
                        <Button Content="2x"
                                Command="{Binding SetPlaybackRateCommand}"
                                CommandParameter="2"
                                IsEnabled="{Binding HasMediaLoaded}"
                                Style="{StaticResource PlaybackMiniButtonStyle}"/>
                        <Button Content="4x"
                                Command="{Binding SetPlaybackRateCommand}"
                                CommandParameter="4"
                                IsEnabled="{Binding HasMediaLoaded}"
                                Style="{StaticResource PlaybackMiniButtonStyle}"/>
                    </WrapPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CurrentWallClockText}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Background="Transparent"
                    CornerRadius="0"
                    Padding="8,6,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Row="0" Grid.Column="0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Timeline" Style="{StaticResource PlaybackTitleStyle}"/>
                            <TextBlock Text="Click to seek, double-click to seek and play."
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource PlaybackMetaStyle}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Border Width="12" Height="12" Background="#BBF7D0" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0"/>
                            <TextBlock Text="Recording" VerticalAlignment="Center" Foreground="#475569" Margin="0,0,12,0"/>
                            <Border Width="12" Height="12" Background="#FEE2E2" BorderBrush="#FB7185" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0"/>
                            <TextBlock Text="No Recording" VerticalAlignment="Center" Foreground="#475569"/>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Margin="18,0,0,0">
                        <TextBlock Text="Jump To Exact Time" Style="{StaticResource PlaybackTitleStyle}"/>
                        <TextBox Height="34"
                                 Margin="0,8,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding JumpToLocalText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Jump"
                                Height="34"
                                Margin="0,8,0,0"
                                Command="{Binding JumpToTimeCommand}"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,6">
                        <ItemsControl ItemsSource="{Binding TimelineTicks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Height="18"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LeftPx}"/>
                                    <Setter Property="Canvas.Top" Value="0"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#475569"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </Border>

                    <Border x:Name="CoverageHost"
                            Grid.Row="4"
                            Grid.Column="0"
                            Height="70"
                            Background="#FEE2E2"
                            BorderBrush="#FB7185"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="3"
                            SizeChanged="CoverageHost_OnSizeChanged"
                            MouseLeftButtonDown="CoverageHost_MouseLeftButtonDown">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding TimelineSegments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Height="62"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding LeftPx}"/>
                                        <Setter Property="Canvas.Top" Value="7"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding WidthPx}"
                                                Height="48"
                                                Background="#BBF7D0"
                                                BorderBrush="#22C55E"
                                                BorderThickness="1"
                                                CornerRadius="6"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Width="3"
                                    Height="62"
                                    Background="White"
                                    BorderBrush="#0F172A"
                                    BorderThickness="1,0,1,0"
                                    HorizontalAlignment="Left">
                                <Border.RenderTransform>
                                    <TranslateTransform X="{Binding PlayheadLeftPx}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>

                    <Slider x:Name="WindowSlider"
                            Grid.Row="6"
                            Grid.Column="0"
                            Minimum="0"
                            Maximum="{Binding TotalTimelineSeconds}"
                            Value="{Binding CurrentTimelineSeconds, Mode=OneWay}"
                            IsEnabled="{Binding HasSegments}"
                            Thumb.DragCompleted="WindowSlider_DragCompleted"/>

                    <StackPanel Grid.Row="2"
                                Grid.RowSpan="5"
                                Grid.Column="1"
                                Margin="18,0,0,0">
                        <TextBlock Text="Export Clip" Style="{StaticResource PlaybackTitleStyle}"/>
                        <TextBox Height="32"
                                 Margin="0,8,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ExportStartLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                        <TextBox Height="32"
                                 Margin="0,8,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ExportEndLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                        <Button Content="Export Range"
                                Height="34"
                                Margin="0,8,0,0"
                                Command="{Binding ExportRangeCommand}"/>
                        <TextBlock Text="{Binding LastExportDisplay}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PlaybackMetaStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
