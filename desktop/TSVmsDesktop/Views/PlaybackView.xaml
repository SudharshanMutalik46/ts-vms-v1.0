<UserControl x:Class="TSVmsDesktop.Views.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:TSVmsDesktop.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PlaybackTileStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="PlaybackSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackground}" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource PlaybackTileStyle}">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="3" Opacity="0.08"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Playback Cameras" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Select camera, pick a time window, then play the archive."
                               Foreground="#64748B" FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"/>
                    <TextBox Height="34"
                             Margin="0,0,0,12"
                             Text="{Binding CameraSearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             Background="#F8FAFC"
                             BorderBrush="#E2E8F0"
                             BorderThickness="1"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding AvailableCameras}"
                         SelectedItem="{Binding SelectedCamera}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E0F2FE"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding IpAddress}" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PlaybackTileStyle}">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="3" Opacity="0.08"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding SelectedCamera.Name, TargetNullValue=Playback Viewer}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding CoverageSummaryText}"
                               Foreground="#475569"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="Black"
                    CornerRadius="14"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    MinHeight="520"
                    ClipToBounds="True">
                <Grid x:Name="PlaybackViewport"
                      Background="Black"
                      ClipToBounds="True">
                    <Border x:Name="PlaybackHostFrame"
                            Background="Black"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ClipToBounds="True">
                        <controls:PlaybackVideoHost x:Name="PlaybackHost"
                                                    MinWidth="64"
                                                    MinHeight="64"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12,10"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel VerticalAlignment="Center">
                        <Button Content="Play/Pause" Command="{Binding TogglePlayPauseCommand}" IsEnabled="{Binding HasSegments}" Margin="0,0,8,0"/>
                        <Button Content="Stop" Command="{Binding StopPlaybackCommand}" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,12,0"/>
                        <Button Content="-10s" Command="{Binding JumpSecondsCommand}" CommandParameter="-10" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,0"/>
                        <Button Content="+10s" Command="{Binding JumpSecondsCommand}" CommandParameter="10" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,0"/>
                        <Button Content="-30s" Command="{Binding JumpSecondsCommand}" CommandParameter="-30" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,0"/>
                        <Button Content="+30s" Command="{Binding JumpSecondsCommand}" CommandParameter="30" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,12,0"/>
                        <Button Content="Prev" Command="{Binding PrevRecordingBlockCommand}" IsEnabled="{Binding HasSegments}" Margin="0,0,8,0"/>
                        <Button Content="Next" Command="{Binding NextRecordingBlockCommand}" IsEnabled="{Binding HasSegments}" Margin="0,0,12,0"/>
                        <Button Content="0.5x" Command="{Binding SetPlaybackRateCommand}" CommandParameter="0.5" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,0"/>
                        <Button Content="1x" Command="{Binding SetPlaybackRateCommand}" CommandParameter="1" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,0"/>
                        <Button Content="2x" Command="{Binding SetPlaybackRateCommand}" CommandParameter="2" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,0"/>
                        <Button Content="4x" Command="{Binding SetPlaybackRateCommand}" CommandParameter="4" IsEnabled="{Binding HasMediaLoaded}"/>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentWallClockText}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding WindowSummaryText}" Foreground="#64748B" FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12"
                    Margin="0,12,0,0"
                    Visibility="{Binding ShowPlayerOverlay, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding PlayerOverlayTitle}"
                               Foreground="#0F172A"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PlayerOverlaySubtitle}"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Margin="0,12,0,0" Style="{StaticResource PlaybackTileStyle}">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="3" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Coverage Timeline" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Border Width="14" Height="14" Background="#BBF7D0" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0"/>
                            <TextBlock Text="Recording" VerticalAlignment="Center" Foreground="#475569" Margin="0,0,14,0"/>
                            <Border Width="14" Height="14" Background="#FEE2E2" BorderBrush="#FB7185" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0"/>
                            <TextBlock Text="No Recording" VerticalAlignment="Center" Foreground="#475569"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding TimelineTicks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Height="18"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LeftPx}"/>
                                    <Setter Property="Canvas.Top" Value="0"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#475569"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border x:Name="CoverageHost"
                            Height="54"
                            Background="#FEE2E2"
                            BorderBrush="#FB7185"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="2"
                            SizeChanged="CoverageHost_OnSizeChanged"
                            MouseLeftButtonDown="CoverageHost_MouseLeftButtonDown">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding TimelineSegments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Height="48"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding LeftPx}"/>
                                        <Setter Property="Canvas.Top" Value="3"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding WidthPx}" Height="42" Background="#BBF7D0" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Width="3" Height="48" Background="White" BorderBrush="#0F172A" BorderThickness="1,0,1,0" HorizontalAlignment="Left">
                                <Border.RenderTransform>
                                    <TranslateTransform X="{Binding PlayheadLeftPx}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>

                    <Slider x:Name="WindowSlider"
                            Margin="0,8,0,0"
                            Minimum="0"
                            Maximum="{Binding TotalTimelineSeconds}"
                            Value="{Binding CurrentTimelineSeconds, Mode=OneWay}"
                            IsEnabled="{Binding HasSegments}"
                            Thumb.DragCompleted="WindowSlider_DragCompleted"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="6" Margin="0,12,0,0" Style="{StaticResource PlaybackTileStyle}">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="3" Opacity="0.06"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Recording day" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <DatePicker Margin="0,8,0,0"
                                    Width="220"
                                    SelectedDate="{Binding SelectedDayLocal, Mode=TwoWay}"
                                    SelectedDateFormat="Short"
                                    HorizontalAlignment="Left"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="15m" Command="{Binding Preset15mCommand}" Style="{StaticResource PlaybackSecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="1h" Command="{Binding Preset1hCommand}" Style="{StaticResource PlaybackSecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="6h" Command="{Binding Preset6hCommand}" Style="{StaticResource PlaybackSecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="24h" Command="{Binding Preset24hCommand}" Style="{StaticResource PlaybackSecondaryButtonStyle}"/>
                        </WrapPanel>

                        <TextBlock Text="Jump to exact time" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBox Width="220"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"
                                     Text="{Binding JumpToLocalText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Jump" Command="{Binding JumpToTimeCommand}" Margin="8,0,0,0" Padding="16,4"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Export time range" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBox Width="170"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"
                                     Text="{Binding ExportStartLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                            <TextBox Width="170"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"
                                     Margin="8,0,0,0"
                                     Text="{Binding ExportEndLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                            <Button Content="Export Range" Command="{Binding ExportRangeCommand}" Margin="8,0,0,0" Padding="16,4"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding LastExportDisplay}" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
