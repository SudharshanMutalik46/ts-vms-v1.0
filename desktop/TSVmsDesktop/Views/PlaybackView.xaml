<UserControl x:Class="TSVmsDesktop.Views.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:TSVmsDesktop.Controls"
             mc:Ignorable="d">

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Background="White" CornerRadius="16" Padding="16">
            <StackPanel>
                <TextBlock Text="Playback Cameras" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Select a camera to inspect recorded segments." Margin="0,6,0,16" Foreground="#64748B" FontSize="12"/>

                <ListBox ItemsSource="{Binding AvailableCameras}" SelectedItem="{Binding SelectedCamera}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,0,0,8" Background="#F8FAFC" CornerRadius="10">
                                <Button Command="{Binding DataContext.LoadSegmentsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}"
                                        Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding IpAddress}" Foreground="#64748B" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <Grid Grid.Column="2" Grid.RowSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding SelectedCamera.Name, TargetNullValue=Playback Viewer}"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#64748B"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#E2E8F0"
                        CornerRadius="10"
                        VerticalAlignment="Center"
                        Padding="12,6">
                    <TextBlock Text="{Binding PlaybackRateText}" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- Diagnostics -->
            <Expander Grid.Row="1"
                      Header="Playback Diagnostics"
                      IsExpanded="{Binding IsDiagnosticsExpanded}"
                      Margin="0,0,0,12">
                <Border Padding="12" Background="#F8FAFC" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Camera ID" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCameraDebugId}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="From UTC" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding QueryFromUtc}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="To UTC" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding QueryToUtc}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Segments API" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SegmentsApiUri}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="HTTP Status" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HttpStatusText}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="API Row Count" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ApiRowCount}" TextWrapping="Wrap"/>

                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Refresh Segments"
                                    Command="{Binding RefreshSelectedCameraCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Copy Diagnostics"
                                    Command="{Binding CopyDiagnosticsCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Expander>

            <!-- Video Surface -->
            <Border Grid.Row="2"
                    Background="Black"
                    CornerRadius="10"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    MinHeight="360">
                <controls:PlaybackVideoHost x:Name="PlaybackHost"/>
            </Border>

            <!-- Controls + Timeline -->
            <StackPanel Grid.Row="3" Margin="0,12,0,12">
                <Slider x:Name="TimelineSlider"
                        Minimum="0"
                        Maximum="{Binding TotalTimelineSeconds}"
                        Value="{Binding CurrentTimelineSeconds, Mode=TwoWay}"
                        IsEnabled="{Binding HasSegments}"
                        PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp"/>

                <DockPanel Margin="0,6,0,10">
                    <TextBlock Text="{Binding CurrentTimeText}" Foreground="#475569"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalTimeText}" Foreground="#475569"/>
                </DockPanel>

                <WrapPanel ItemHeight="36" ItemWidth="84">
                    <Button Content="Play/Pause" Command="{Binding TogglePlayPauseCommand}" IsEnabled="{Binding HasSegments}" Margin="0,0,8,8"/>
                    <Button Content="Stop" Command="{Binding StopPlaybackCommand}" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,8"/>
                    <Button Content="-10s" Command="{Binding JumpSecondsCommand}" CommandParameter="-10" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,8"/>
                    <Button Content="+10s" Command="{Binding JumpSecondsCommand}" CommandParameter="10" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,8"/>
                    <Button Content="-30s" Command="{Binding JumpSecondsCommand}" CommandParameter="-30" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,8"/>
                    <Button Content="+30s" Command="{Binding JumpSecondsCommand}" CommandParameter="30" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,8"/>
                    <Button Content="◀ Frame" Command="{Binding StepFrameCommand}" CommandParameter="-1" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,8"/>
                    <Button Content="Frame ▶" Command="{Binding StepFrameCommand}" CommandParameter="1" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,8"/>
                    <Button Content="⟲ Rotate" Command="{Binding RotateLeftCommand}" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,8"/>
                    <Button Content="Rotate ⟳" Command="{Binding RotateRightCommand}" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,8"/>
                    <Button Content="Reset Rot" Command="{Binding ResetRotationCommand}" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,8"/>
                    <Button Content="0.5x" Command="{Binding SetPlaybackRateCommand}" CommandParameter="0.5" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,8"/>
                    <Button Content="1x" Command="{Binding SetPlaybackRateCommand}" CommandParameter="1" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,8"/>
                    <Button Content="2x" Command="{Binding SetPlaybackRateCommand}" CommandParameter="2" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,8"/>
                    <Button Content="4x" Command="{Binding SetPlaybackRateCommand}" CommandParameter="4" IsEnabled="{Binding HasMediaLoaded}" Margin="0,0,8,8"/>
                </WrapPanel>
            </StackPanel>

            <!-- Segment Grid -->
            <Border Grid.Row="4"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Recorded Segments"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Grid.Row="0"
                               Margin="0,0,0,8"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecordingSegments}"
                              SelectedItem="{Binding SelectedSegment, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              MouseDoubleClick="SegmentsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Start" Binding="{Binding StartTs, StringFormat={}{0:G}}" Width="170"/>
                            <DataGridTextColumn Header="End" Binding="{Binding EndTs, StringFormat={}{0:G}}" Width="170"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="110"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="110"/>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="180"/>
                            <DataGridTextColumn Header="Storage Path" Binding="{Binding Path}" Width="*"/>
                            <DataGridTemplateColumn Header="Action" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Play"
                                                Command="{Binding DataContext.PlaySegmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
