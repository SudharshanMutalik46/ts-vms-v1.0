<UserControl x:Class="TSVmsDesktop.Views.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:TSVmsDesktop.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PlaybackShellCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="PlaybackTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="PlaybackMetaStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="PlaybackMiniButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent" Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="182"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="Transparent"
                    CornerRadius="0"
                    Padding="12,8,8,8">
                <StackPanel>
                    <TextBlock Text="Common"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                    <DatePicker Margin="0,10,0,0"
                                SelectedDate="{Binding SelectedDayLocal, Mode=TwoWay}"
                                SelectedDateFormat="Short"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="Transparent"
                    CornerRadius="0"
                    Padding="12,8,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Playback Cameras"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Select up to 4 cameras to review archived footage."
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PlaybackMetaStyle}"/>
                        <TextBlock Text="Tick the checkboxes to select up to 4 cameras."
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PlaybackMetaStyle}"/>
                    </StackPanel>

                    <TextBox Grid.Row="2"
                             Height="36"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding CameraSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#F8FAFC"
                             BorderBrush="#E2E8F0"
                             BorderThickness="1"/>

                    <ListBox x:Name="PlaybackCameraList"
                             Grid.Row="4"
                             ItemsSource="{Binding AvailablePlaybackCameras}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12,10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Checked="PlaybackCameraCheckBox_Changed"
                                          Unchecked="PlaybackCameraCheckBox_Changed"
                                          FontWeight="SemiBold"
                                          Foreground="#0F172A"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="6"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Export Clip"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>

                            <TextBox Height="32"
                                     Margin="0,8,0,0"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ExportStartLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>

                            <TextBox Height="32"
                                     Margin="0,8,0,0"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ExportEndLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>

                            <Button Content="Export Range"
                                    Height="34"
                                    Margin="0,8,0,0"
                                    Command="{Binding ExportRangeCommand}"/>

                            <TextBlock Text="{Binding LastExportDisplay}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource PlaybackMetaStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

            <Grid Grid.Column="2" x:Name="PlaybackContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

            <Border x:Name="PlaybackStage"
                    Grid.Row="0"
                    Background="Transparent"
                    Padding="0"
                    CornerRadius="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    ClipToBounds="True">
                <Grid x:Name="PlaybackViewport" Background="Transparent" ClipToBounds="True">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="PlaybackTile1" Grid.Row="0" Grid.Column="0" Margin="6" Background="#000000" BorderBrush="#1E293B" BorderThickness="1">
                            <Grid>
                                <controls:VideoCanvas x:Name="PlaybackHost1"
                                                      Tag="0"
                                                      Loaded="PlaybackTileHost_Loaded"
                                                      SizeChanged="PlaybackTileHost_SizeChanged"
                                                      MinWidth="64"
                                                      MinHeight="64"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12">
                                    <TextBlock Text="{Binding PlaybackSlots[0].CameraName}" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PlaybackSlots[0].StatusText}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Foreground="#CBD5E1"/>
                            </Grid>
                        </Border>

                        <Border x:Name="PlaybackTile2" Grid.Row="0" Grid.Column="1" Margin="6" Background="#000000" BorderBrush="#1E293B" BorderThickness="1">
                            <Grid>
                                <controls:VideoCanvas x:Name="PlaybackHost2"
                                                      Tag="1"
                                                      Loaded="PlaybackTileHost_Loaded"
                                                      SizeChanged="PlaybackTileHost_SizeChanged"
                                                      MinWidth="64"
                                                      MinHeight="64"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12">
                                    <TextBlock Text="{Binding PlaybackSlots[1].CameraName}" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PlaybackSlots[1].StatusText}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Foreground="#CBD5E1"/>
                            </Grid>
                        </Border>

                        <Border x:Name="PlaybackTile3" Grid.Row="1" Grid.Column="0" Margin="6" Background="#000000" BorderBrush="#1E293B" BorderThickness="1">
                            <Grid>
                                <controls:VideoCanvas x:Name="PlaybackHost3"
                                                      Tag="2"
                                                      Loaded="PlaybackTileHost_Loaded"
                                                      SizeChanged="PlaybackTileHost_SizeChanged"
                                                      MinWidth="64"
                                                      MinHeight="64"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12">
                                    <TextBlock Text="{Binding PlaybackSlots[2].CameraName}" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PlaybackSlots[2].StatusText}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Foreground="#CBD5E1"/>
                            </Grid>
                        </Border>

                        <Border x:Name="PlaybackTile4" Grid.Row="1" Grid.Column="1" Margin="6" Background="#000000" BorderBrush="#1E293B" BorderThickness="1">
                            <Grid>
                                <controls:VideoCanvas x:Name="PlaybackHost4"
                                                      Tag="3"
                                                      Loaded="PlaybackTileHost_Loaded"
                                                      SizeChanged="PlaybackTileHost_SizeChanged"
                                                      MinWidth="64"
                                                      MinHeight="64"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12">
                                    <TextBlock Text="{Binding PlaybackSlots[3].CameraName}" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PlaybackSlots[3].StatusText}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Foreground="#CBD5E1"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,14,14,0"
                            Padding="12,10"
                            Background="#CCFFFFFF"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="{Binding CoverageSummaryText}"
                                       Foreground="#334155"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding WindowSummaryText}"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource PlaybackMetaStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#BF020617"
                            Visibility="{Binding ShowPlayerOverlay, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                            <TextBlock Text="{Binding PlayerOverlayTitle}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock Text="{Binding PlayerOverlaySubtitle}"
                                       Margin="0,10,0,0"
                                       Foreground="#CBD5E1"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>



            <Border Grid.Row="2"
                    Background="Transparent"
                    CornerRadius="0"
                    Padding="8,6,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Toolbar -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/> <!-- Ruler (Ticks) -->
                        <RowDefinition Height="Auto"/> <!-- Timeline Rows -->
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/> <!-- Slider -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Transport Toolbar (NVR Style) -->
                    <Border Grid.Row="0" Grid.Column="0" 
                            Background="#F1F5F9" CornerRadius="12" Padding="12,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="|&lt;" Command="{Binding PreviousCommand}" Style="{StaticResource PlaybackMiniButtonStyle}" ToolTip="Previous Segment"/>
                                <Button Content="&lt;&lt;" Command="{Binding SeekBackCommand}" Style="{StaticResource PlaybackMiniButtonStyle}" ToolTip="Seek Back 10s"/>
                                
                                <Separator Width="1" Margin="8,4" Background="#CBD5E1"/>
                                
                                <Button Content="Play/Pause" Command="{Binding TogglePlayPauseCommand}" 
                                        IsEnabled="{Binding HasSegments}"
                                        Style="{StaticResource PlaybackMiniButtonStyle}"/>
                                <Button Content="Stop" Command="{Binding StopPlaybackCommand}" 
                                        IsEnabled="{Binding HasMediaLoaded}"
                                        Style="{StaticResource PlaybackMiniButtonStyle}"/>

                                <Separator Width="1" Margin="8,4" Background="#CBD5E1"/>

                                <Button Content="&gt;&gt;" Command="{Binding SeekForwardCommand}" Style="{StaticResource PlaybackMiniButtonStyle}" ToolTip="Seek Forward 10s"/>
                                <Button Content="&gt;|" Command="{Binding NextCommand}" Style="{StaticResource PlaybackMiniButtonStyle}" ToolTip="Next Segment"/>

                                <Separator Width="1" Margin="8,4" Background="#CBD5E1"/>

                                <Button Content="1x" Command="{Binding SetRate1xCommand}" IsEnabled="{Binding HasMediaLoaded}" Style="{StaticResource PlaybackMiniButtonStyle}"/>
                                <Button Content="2x" Command="{Binding SetRate2xCommand}" IsEnabled="{Binding HasMediaLoaded}" Style="{StaticResource PlaybackMiniButtonStyle}"/>
                                <Button Content="4x" Command="{Binding SetRate4xCommand}" IsEnabled="{Binding HasMediaLoaded}" Style="{StaticResource PlaybackMiniButtonStyle}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentWallClockText}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding PlaybackRateText}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: Shared Ruler (Ticks) -->
                    <Border Grid.Row="2" Grid.Column="0" 
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1,1,1,0" CornerRadius="10,10,0,0" Padding="8,4">
                        <ItemsControl ItemsSource="{Binding TimelineTicks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Height="18"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LeftPx}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#475569"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Row 3: Multi-row Timelines (C1-C4) -->
                    <ItemsControl Grid.Row="3" Grid.Column="0" ItemsSource="{Binding PlaybackTimelines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="60" Margin="0,0,0,4" 
                                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="8,0,0,8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding CameraName}" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="56"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" x:Name="TimelineHost" 
                                                Background="#FEE2E2" Padding="2" Tag="{Binding SlotIndex}"
                                                SizeChanged="PlaybackTimelineHost_OnSizeChanged"
                                                MouseLeftButtonDown="PlaybackTimelineHost_MouseLeftButtonDown">
                                            <Grid>
                                                <ItemsControl ItemsSource="{Binding Segments}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas Height="52"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding LeftPx}"/>
                                                            <Setter Property="Canvas.Top" Value="4"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="{Binding WidthPx}" Height="40" Background="#BBF7D0" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Playhead Overlay (Shared position) -->
                                                <Border Width="2" Background="#EF4444" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="{Binding DataContext.PlayheadLeftPx, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Row 5: Global Playhead Slider -->
                    <Slider x:Name="WindowSlider" Grid.Row="5" Grid.Column="0" Margin="60,0,0,0"
                            Minimum="0" Maximum="{Binding TotalTimelineSeconds}"
                            Value="{Binding CurrentTimelineSeconds, Mode=OneWay}"
                            IsEnabled="{Binding HasSegments}"
                            Thumb.DragCompleted="WindowSlider_DragCompleted"/>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
