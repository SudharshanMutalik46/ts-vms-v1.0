<UserControl x:Class="TSVmsDesktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel Margin="0,0,0,20">

                <Grid Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="Configuration" FontSize="28" FontWeight="Bold" Foreground="#F2F2F2"/>
                        <TextBlock Text="Manage local application preferences" FontSize="15" Foreground="#B8B8BC" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Background="#2B2B2E" BorderBrush="#4A4A4F" BorderThickness="1" CornerRadius="15" Padding="40">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDD" BlurRadius="25" ShadowDepth="5" Opacity="0.3"/>
                    </Border.Effect>
                    
                    <StackPanel>
                        <TextBlock Text="Local Recording Path" FontSize="14" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,0,0,10"/>
                        
                        <Grid Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding StoragePath}" Style="{StaticResource ModernInputStyle}" 
                                     FontSize="14" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                            
                            <Button Grid.Column="1"
                                    Command="{Binding BrowseFolderCommand}"
                                    Content="Browse"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Margin="0,0,0,0"
                                    Height="44"/>
                        </Grid>
                        
                        <TextBlock Text="Video clips and snapshots will be saved to this folder." FontSize="12" Foreground="#B8B8BC" Margin="0,8,0,30"/>

                        <Separator Background="#3A3A3D" Margin="0,0,0,30"/>

                        <TextBlock Text="System Options" FontSize="14" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,0,0,15"/>
                        
                        <CheckBox Content="Enable Hardware Acceleration (GPU)" IsChecked="{Binding EnableHardwareAcceleration}" 
                                  Style="{StaticResource ModernCheckBox}" Margin="0,0,0,15">
                             <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        
                        <CheckBox Content="Enable Dark Mode (Beta)" IsChecked="{Binding EnableDarkMode}" 
                                  Style="{StaticResource ModernCheckBox}" Margin="0,0,0,30">
                             <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>

                        <Separator Background="#3A3A3D" Margin="0,0,0,30"/>

                        <TextBlock Text="System Log Level" FontSize="14" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,0,0,10"/>
                        
                        <ComboBox SelectedValue="{Binding LogLevel}" SelectedValuePath="Content" 
                                  Style="{StaticResource ModernComboBox}" Width="300" HorizontalAlignment="Left" Height="45">
                            <ComboBoxItem Content="Debug"/>
                            <ComboBoxItem Content="Info"/>
                            <ComboBoxItem Content="Warn"/>
                            <ComboBoxItem Content="Error"/>
                        </ComboBox>
                        
                        <TextBlock Text="Higher levels reduce disk usage but provide less detail." FontSize="12" Foreground="#B8B8BC" Margin="0,8,0,0"/>

                        <Button Command="{Binding SaveCommand}"
                                Content="Save Configuration"
                                Style="{StaticResource PillButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,50,0,0"
                                Height="44"
                                Padding="28,0"/>
                        
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
