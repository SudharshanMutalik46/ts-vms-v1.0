<UserControl x:Class="TSVmsDesktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel Margin="0,0,0,20">

                <Grid Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="Configuration" FontSize="28" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="Manage local application preferences" FontSize="15" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Background="White" CornerRadius="15" Padding="40">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDD" BlurRadius="25" ShadowDepth="5" Opacity="0.3"/>
                    </Border.Effect>
                    
                    <StackPanel>
                        <TextBlock Text="Local Recording Path" FontSize="14" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,10"/>
                        
                        <Grid Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding StoragePath}" Style="{StaticResource ModernInputStyle}" 
                                     FontSize="14" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                            
                            <Button Grid.Column="1" Command="{Binding BrowseFolderCommand}" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdr" Background="#F0F0F0" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="📂" Margin="0,0,8,0" FontSize="14"/>
                                                <TextBlock Text="Browse" FontWeight="SemiBold" Foreground="#555" FontSize="13"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bdr" Property="Background" Value="#E8E8E8"/>
                                                <Setter TargetName="bdr" Property="BorderBrush" Value="#CCC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        
                        <TextBlock Text="Video clips and snapshots will be saved to this folder." FontSize="12" Foreground="#999" Margin="0,8,0,30"/>

                        <Separator Background="#F0F0F0" Margin="0,0,0,30"/>

                        <TextBlock Text="System Options" FontSize="14" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,15"/>
                        
                        <CheckBox Content="Enable Hardware Acceleration (GPU)" IsChecked="{Binding EnableHardwareAcceleration}" 
                                  Style="{StaticResource ModernCheckBox}" Margin="0,0,0,15">
                             <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        
                        <CheckBox Content="Enable Dark Mode (Beta)" IsChecked="{Binding EnableDarkMode}" 
                                  Style="{StaticResource ModernCheckBox}" Margin="0,0,0,30">
                             <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>

                        <Separator Background="#F0F0F0" Margin="0,0,0,30"/>

                        <TextBlock Text="System Log Level" FontSize="14" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,10"/>
                        
                        <ComboBox SelectedValue="{Binding LogLevel}" SelectedValuePath="Content" 
                                  Style="{StaticResource ModernComboBox}" Width="300" HorizontalAlignment="Left" Height="45">
                            <ComboBoxItem Content="Debug"/>
                            <ComboBoxItem Content="Info"/>
                            <ComboBoxItem Content="Warn"/>
                            <ComboBoxItem Content="Error"/>
                        </ComboBox>
                        
                        <TextBlock Text="Higher levels reduce disk usage but provide less detail." FontSize="12" Foreground="#999" Margin="0,8,0,0"/>

                        <Button Command="{Binding SaveCommand}" 
                                HorizontalAlignment="Left" Margin="0,50,0,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{StaticResource TechnoOrange}" CornerRadius="25" Padding="40,14">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#E65100" BlurRadius="15" ShadowDepth="4" Opacity="0.25"/>
                                        </Border.Effect>
                                        <TextBlock Text="Save Configuration" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                            <Setter TargetName="btnBorder" Property="Background" Value="#CC4600"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                             <Setter TargetName="btnBorder" Property="RenderTransform">
                                                 <Setter.Value>
                                                     <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                                 </Setter.Value>
                                             </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
