<UserControl x:Class="TSVmsDesktop.Views.NvrsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="NVR Inventory" FontSize="26" FontWeight="Bold" Foreground="#333" Margin="0,0,30,0"/>
            <Button Command="{Binding AddNvrCommand}" Content="+ Add NVR" Style="{StaticResource PillButtonStyle}" Width="120" Height="40"/>
            <Button Command="{Binding LoadNvrsCommand}" Content="Refresh" Margin="10,0,0,0" Style="{StaticResource OutlineButtonStyle}" Foreground="#555" BorderBrush="#CCC" Height="40"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Nvrs}" AutoGenerateColumns="False" 
                  Background="White" BorderThickness="0" RowHeight="50" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
                  CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Resources>
                 <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F5F7FA"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="Height" Value="35"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="150"/>
                <DataGridTextColumn Header="Adapter" Binding="{Binding AdapterType}" Width="120"/>
                <DataGridTemplateColumn Header="Actions" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Configure" Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" Style="{StaticResource OutlineButtonStyle}" Foreground="#2196F3" BorderBrush="#2196F3" Height="30" Padding="15,0"/>
                                <Button Content="Delete" Command="{Binding DataContext.DeleteNvrCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" Margin="10,0,0,0" Style="{StaticResource OutlineButtonStyle}" Foreground="#D32F2F" BorderBrush="#D32F2F" Height="30"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
