<UserControl x:Class="TSVmsDesktop.Views.NvrsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="NvrPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>

        <Style x:Key="NvrSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#4A4A4F"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackground}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#2B2B2E" BorderBrush="#4A4A4F" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,0,0,18">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="3" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NVR Inventory" FontSize="28" FontWeight="Bold" Foreground="#F2F2F2"/>
                    <TextBlock Text="Register recorders, review adapters, and open configuration details."
                               Foreground="#B8B8BC" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding AddNvrCommand}" Content="+ Add NVR" Style="{StaticResource NvrPrimaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Command="{Binding LoadNvrsCommand}" Content="Refresh" Style="{StaticResource NvrSecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#2B2B2E" BorderBrush="#4A4A4F" BorderThickness="1" CornerRadius="18" Padding="8">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="3" Opacity="0.06"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Nvrs}"
                      AutoGenerateColumns="False"
                      Background="#29292D"
                      RowBackground="#29292D"
                      AlternatingRowBackground="#303034"
                      Foreground="#F2F2F2"
                      BorderThickness="0"
                      RowHeight="50"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#3A3A3D"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#3A3A3D"/>
                        <Setter Property="Foreground" Value="#F2F2F2"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#4A4A4F"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="150"/>
                    <DataGridTextColumn Header="Adapter" Binding="{Binding AdapterType}" Width="120"/>
                    <DataGridTemplateColumn Header="Actions" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Configure"
                                            Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource NvrSecondaryButtonStyle}"
                                            Foreground="#2563EB"
                                            BorderBrush="#93C5FD"
                                            Margin="0,0,10,0"/>
                                    <Button Content="Delete"
                                            Command="{Binding DataContext.DeleteNvrCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource NvrSecondaryButtonStyle}"
                                            Foreground="#B91C1C"
                                            BorderBrush="#FECACA"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
