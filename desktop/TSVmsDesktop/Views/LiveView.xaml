<UserControl x:Class="TSVmsDesktop.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TSVmsDesktop.Controls"
             xmlns:converters="clr-namespace:TSVmsDesktop.Converters"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             Unloaded="UserControl_Unloaded"
             Loaded="UserControl_Loaded"
             Focusable="True">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        
        <DropShadowEffect x:Key="SoftShadow" Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>

        <Style x:Key="EnterpriseCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E5E9F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource TechnoOrange}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.01" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.01" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="PulsingStatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="{Binding StatusColor}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <BlurEffect Radius="2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.4" Duration="0:0:1" AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding ExitFullScreenCommand}"/>
    </UserControl.InputBindings>

    <Grid Background="#F8FAFC">
        
        <Grid Visibility="{Binding IsFullScreen, Converter={StaticResource InverseBoolToVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="*"/>   
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="25,25,25,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Live Dashboard" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
                    <Border Background="#F0F9FF" CornerRadius="12" Padding="12,4" Margin="15,0,0,0" BorderThickness="1" BorderBrush="#BAE6FD">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#0EA5E9" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ActiveStreamCount, StringFormat='{}{0} ONLINE'}" 
                                       Foreground="#0369A1" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                     <!-- LAYOUT BUTTONS -->
                     <Border Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Margin="0,0,15,0" Padding="4">
                         <StackPanel Orientation="Horizontal">
                             <Button Content=" 1x1 " Command="{Binding SetLayoutCommand}" CommandParameter="1" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#64748B" FontWeight="SemiBold" Margin="2,0"/>
                             <Button Content=" 2x2 " Command="{Binding SetLayoutCommand}" CommandParameter="2" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#64748B" FontWeight="SemiBold" Margin="2,0"/>
                             <Button Content=" 3x3 " Command="{Binding SetLayoutCommand}" CommandParameter="3" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#64748B" FontWeight="SemiBold" Margin="2,0"/>
                             <Button Content=" 4x4 " Command="{Binding SetLayoutCommand}" CommandParameter="4" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#64748B" FontWeight="SemiBold" Margin="2,0"/>
                         </StackPanel>
                     </Border>

                     <Button Command="{Binding SyncCommand}" Width="40" Height="40" Background="#FFFFFF" BorderThickness="1" BorderBrush="#E2E8F0" 
                             Foreground="#64748B" Margin="0,0,12,0" Cursor="Hand" ToolTip="Sync Status">
                         <Button.Resources>
                             <Style TargetType="Border">
                                 <Setter Property="CornerRadius" Value="8"/>
                             </Style>
                         </Button.Resources>
                         <TextBlock Text="↻" FontSize="18" RenderTransformOrigin="0.5,0.5">
                             <TextBlock.RenderTransform>
                                 <RotateTransform Angle="0"/>
                             </TextBlock.RenderTransform>
                             <TextBlock.Style>
                                 <Style TargetType="TextBlock">
                                     <Style.Triggers>
                                         <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                             <DataTrigger.EnterActions>
                                                 <BeginStoryboard>
                                                     <Storyboard>
                                                         <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" 
                                                                          To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/>
                                                     </Storyboard>
                                                 </BeginStoryboard>
                                             </DataTrigger.EnterActions>
                                         </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </TextBlock.Style>
                         </TextBlock>
                     </Button>

                    <Button Command="{Binding ConnectDemoCommand}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource TechnoOrange}" CornerRadius="8" Padding="20,10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#E65100" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▶" Foreground="White" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Start All Streams" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- CAMERA GRID -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding CameraGrid}" Margin="15,0,15,15">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding DataContext.GridRows, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                     Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/> 
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8" CornerRadius="12" Background="White" ClipToBounds="True" MouseLeftButtonDown="CameraGrid_MouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#94A3B8" BlurRadius="12" Opacity="0.15" ShadowDepth="4"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#0EA5E9"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                     <DropShadowEffect Color="#0EA5E9" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#F97316"/> <!-- TechnoOrange -->
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                     <DropShadowEffect Color="#F97316" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>   <!-- Video Area -->
                                    <RowDefinition Height="65"/>  <!-- Info Area -->
                                </Grid.RowDefinitions>

                                <!-- 1. VIDEO LAYER (Row 0) -->
                                <Grid Grid.Row="0" ClipToBounds="True">
                                    
                                    <!-- No Signal Placeholder (Light Theme) -->
                                    <Grid x:Name="NoSignalOverlay" Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisConverter}}">
                                        <Grid Background="#F1F5F9"> <!-- Darkened from F8FAFC to F1F5F9 -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.9">
                                                <Path x:Name="OverlayIcon" Stretch="Uniform" Width="48" Height="48" HorizontalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 0 0 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM19 18H6c-2.21 0-4-1.79-4-4 0-2.05 1.53-3.76 3.56-3.97l1.07-.11.5-.95A5.99 5.99 0 0 1 12 6c2.62 0 4.88 1.86 5.81 4.43l.48 1.34 1.37.27c2.09.41 3.23 2.65 2.22 4.63-.49.97-1.5 1.33-2.88 1.33z"/>
                                                            <Setter Property="Fill" Value="#94A3B8"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStreamFailed}" Value="True">
                                                                    <Setter Property="Data" Value="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock x:Name="OverlayText" FontSize="11" FontWeight="Bold" Margin="0,15,0,5" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="NO SIGNAL"/>
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStreamFailed}" Value="True">
                                                                    <Setter Property="Text" Value="SIGNAL LOST"/>
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            
                                            <!-- Status Badge -->
                                            <Border x:Name="OverlayBadge" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E2E8F0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStreamFailed}" Value="True">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock x:Name="OverlayBadgeText" FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="OFFLINE"/>
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStreamFailed}" Value="True">
                                                                    <Setter Property="Text" Value="ERROR"/>
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <!-- Video Surface -->
                                    <controls:VideoCanvas x:Name="VideoSurface" 
                                                          DataContext="{Binding}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"
                                                          Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                          IsVisibleChanged="VideoSurface_IsVisibleChanged"/>



                                    <!-- TOP BADGES -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10"
                                                Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <!-- Phase 4 Recording Status Badge -->
                                        <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                Visibility="{Binding CameraVM.IsRecordingBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#10B981"/> <!-- Green Default -->
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CameraVM.RecordingBadgeText}" Value="REC">
                                                            <Setter Property="Background" Value="#EF4444"/> <!-- Red for REC -->
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CameraVM.RecordingBadgeText}" Value="RETRYING...">
                                                            <Setter Property="Background" Value="#F59E0B"/> <!-- Yellow for Retry -->
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Only show red dot if actually recording -->
                                                <Ellipse Width="4" Height="4" Fill="White" Margin="0,0,4,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CameraVM.RecordingBadgeText}" Value="REC">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding CameraVM.RecordingBadgeText}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#3B82F6" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="LIVE" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- NEW HOVER TOOLBAR -->
                                    <Border x:Name="HoverToolbar" Background="#B3000000" CornerRadius="6"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10" Opacity="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button ToolTip="Snapshot" Command="{Binding DataContext.SnapshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding CameraName}" Background="Transparent" BorderThickness="0" Padding="8" Cursor="Hand">
                                                <TextBlock Text="📷" Foreground="White"/>
                                            </Button>
                                            <Button ToolTip="Full Window" Command="{Binding DataContext.EnterFullScreenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="8" Cursor="Hand">
                                                <TextBlock Text="⛶" Foreground="White" FontWeight="Bold"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                </Grid>

                                <!-- 2. INFO LAYER (Row 1) - White -->
                                <Grid Grid.Row="1" Background="White" Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/> <!-- Audio Icon -->
                                        <ColumnDefinition Width="Auto"/> <!-- Full Window Button -->
                                        <ColumnDefinition Width="Auto"/> <!-- Menu Button -->
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Status Dot (Pulsing) -->
                                    <Ellipse Grid.Column="0" Margin="0,2,12,0" Style="{StaticResource PulsingStatusDot}"/>
                                    
                                    <!-- Text Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CameraName}" Foreground="#1E293B" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{Binding StatusColor, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding IpAddress, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Audio Indicator -->
                                    <TextBlock Grid.Column="2" 
                                               FontSize="15" 
                                               Margin="0,0,10,0"
                                               FontFamily="Segoe UI Emoji" 
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasAudioCapability, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="🔇" />
                                                <Setter Property="Foreground" Value="#94A3B8" /> 
                                                <Setter Property="ToolTip" Value="Camera has audio (Muted)" />
                                                
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAudioPlaying}" Value="True">
                                                        <Setter Property="Text" Value="🔊" />
                                                        <Setter Property="Foreground" Value="#10B981" /> 
                                                        <Setter Property="ToolTip" Value="Audio Actively Playing" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Full Window Button -->
                                    <Button Grid.Column="3" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                            Command="{Binding DataContext.EnterFullScreenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}"
                                            ToolTip="Full Window">
                                        <Path Data="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" 
                                              Fill="#94A3B8" Stretch="Uniform" Width="14" Height="14"/>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                 <Setter Property="Template">
                                                     <Setter.Value>
                                                         <ControlTemplate TargetType="Button">
                                                             <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                             </Border> 
                                                         </ControlTemplate>
                                                     </Setter.Value> 
                                                 </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TechnoOrange}"/> <!-- Use in Path binding if needed, or simple trigger -->
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Menu Button -->
                                    <Button Grid.Column="4" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,-4,0"
                                            ToolTip="More Options">
                                        <Path Data="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" 
                                              Fill="#CBD5E1" Stretch="Uniform" Width="4" Height="16"/>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                 <Setter Property="Template">
                                                     <Setter.Value>
                                                         <ControlTemplate TargetType="Button">
                                                             <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                                                 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                             </Border> 
                                                         </ControlTemplate>
                                                     </Setter.Value> 
                                                 </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverToolbar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverToolbar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- PAGINATION FOOTER -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button Command="{Binding PreviousPageCommand}" Width="40" Height="40" Background="White" BorderThickness="1" BorderBrush="#E2E8F0" Cursor="Hand" ToolTip="Previous Page">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="◄" FontSize="16" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                
                <TextBlock Text="{Binding CurrentPageDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" Margin="20,0"/>
                
                <Button Command="{Binding NextPageCommand}" Width="40" Height="40" Background="White" BorderThickness="1" BorderBrush="#E2E8F0" Cursor="Hand" ToolTip="Next Page">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="►" FontSize="16" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>


        <Grid Visibility="{Binding IsFullScreen, Converter={StaticResource BooleanToVisibilityConverter}}" 
              x:Name="FullScreenGrid">
            
            <Border Background="Black" /> <!-- Underlying theater background -->
            
            <controls:VideoCanvas x:Name="FullScreenPlayer" 
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                  IsVisibleChanged="FullScreenPlayer_IsVisibleChanged"/>

            <!-- Premium Full Screen Overlay (Top Bar) -->
            <!-- Positioned absolutely to ensure it stays on top of the native video surface -->
            <Popup IsOpen="{Binding IsFullScreen}" 
                   Placement="Absolute" 
                   HorizontalOffset="0"
                   VerticalOffset="0"
                   Width="{Binding ActualWidth, ElementName=FullScreenGrid}"
                   Height="150"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Grid Height="120" VerticalAlignment="Top" x:Name="FullScreenHeader">
                    <!-- Glassy Background with Gradient -->
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#CC000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- Auto-Hide Trigger REMOVED for stability -->
                    <!-- Top bar will remain visible to ensure accessibility -->
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="1"/> 
                        </Style>
                    </Grid.Style>

                    <Grid Margin="40,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Glassy Exit Button (Left) -->
                        <Button Grid.Column="0" Command="{Binding ExitFullScreenCommand}" 
                                Width="48" Height="48" Cursor="Hand"
                                ToolTip="Exit Full Screen (Esc)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonBorder" CornerRadius="24" Background="#66000000" BorderThickness="1.5" BorderBrush="#88FFFFFF">
                                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                              Fill="White" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#EF4444"/>
                                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#EF4444"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Camera Metadata (Right) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="25,0">
                            <TextBlock Text="{Binding SelectedCameraName}" Foreground="White" FontSize="20" FontWeight="SemiBold">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{Binding Source={x:Static System:DateTime.Now}, StringFormat='{}{0:dd MMM yyyy, HH:mm:ss}'}" 
                                     Foreground="#EEEEEE" FontSize="14" Margin="0,3,0,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Popup>
        </Grid>

    </Grid>
</UserControl>