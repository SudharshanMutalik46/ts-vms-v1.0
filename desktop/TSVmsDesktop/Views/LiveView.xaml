<UserControl x:Class="TSVmsDesktop.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TSVmsDesktop.Controls"
             xmlns:converters="clr-namespace:TSVmsDesktop.Converters"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             Unloaded="UserControl_Unloaded"
             Loaded="UserControl_Loaded"
             Focusable="True">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>

        <DropShadowEffect x:Key="HeaderShadow" Color="#0F172A" BlurRadius="18" ShadowDepth="4" Opacity="0.08"/>
        <DropShadowEffect x:Key="TileShadow" Color="#0F172A" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>

        <Style x:Key="LiveActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#D9E2EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource TechnoOrange}"/>
                    <Setter Property="Foreground" Value="{StaticResource TechnoOrange}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LiveOverlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#66050816"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B318273A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B325384A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiveChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#F0F9FF"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="LiveTileStyle" TargetType="Border">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#050816"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="CacheMode">
                <Setter.Value>
                    <BitmapCache EnableClearType="False"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect" Value="{StaticResource TileShadow}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource TechnoOrange}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                    <Setter Property="Background" Value="#020617"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                    <Setter Property="Effect" Value="{StaticResource TileShadow}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LiveSurfaceBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#E2E8F0"/>
        </Style>

        <Style x:Key="PulsingStatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="{Binding StatusColor}"/>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding ExitFullScreenCommand}"/>
    </UserControl.InputBindings>

    <Grid x:Name="LiveViewRoot" Background="#EEF3F9" SnapsToDevicePixels="True" UseLayoutRounding="True"
          PreviewMouseMove="LiveViewRoot_PreviewMouseMove"
          MouseLeave="LiveViewRoot_MouseLeave">
        
        <Grid x:Name="DashboardGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="*"/>   
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="25,25,25,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Live Dashboard" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
                    <Border Style="{StaticResource LiveChipStyle}" Margin="15,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#0EA5E9" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ActiveStreamCount, StringFormat='{}{0} ONLINE'}" 
                                       Foreground="#0369A1" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                     <!-- LAYOUT BUTTONS -->
                     <Border Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Margin="0,0,15,0" Padding="4">
                         <StackPanel Orientation="Horizontal">
                             <Button Content=" 1x1 " Command="{Binding SetLayoutCommand}" CommandParameter="1" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#64748B" FontWeight="SemiBold" Margin="2,0"/>
                             <Button Content=" 2x2 " Command="{Binding SetLayoutCommand}" CommandParameter="2" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#64748B" FontWeight="SemiBold" Margin="2,0"/>
                             <Button Content=" 3x3 " Command="{Binding SetLayoutCommand}" CommandParameter="3" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#64748B" FontWeight="SemiBold" Margin="2,0"/>
                             <Button Content=" 4x4 " Command="{Binding SetLayoutCommand}" CommandParameter="4" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#64748B" FontWeight="SemiBold" Margin="2,0"/>
                         </StackPanel>
                     </Border>

                     <Button Command="{Binding SyncCommand}" Width="40" Height="40" Background="#FFFFFF" BorderThickness="1" BorderBrush="#E2E8F0" 
                             Foreground="#64748B" Margin="0,0,12,0" Cursor="Hand" ToolTip="Sync Status">
                         <Button.Resources>
                             <Style TargetType="Border">
                                 <Setter Property="CornerRadius" Value="8"/>
                             </Style>
                         </Button.Resources>
                          <TextBlock Text="&#x21BB;" FontSize="18" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
                             <TextBlock.RenderTransform>
                                 <RotateTransform Angle="0"/>
                             </TextBlock.RenderTransform>
                             <TextBlock.Style>
                                 <Style TargetType="TextBlock">
                                     <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                             <DataTrigger.EnterActions>
                                                 <BeginStoryboard x:Name="SyncSpinStoryboard">
                                                     <Storyboard>
                                                         <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                          From="0" To="360" Duration="0:0:0.8"
                                                                          RepeatBehavior="Forever"/>
                                                     </Storyboard>
                                                 </BeginStoryboard>
                                             </DataTrigger.EnterActions>
                                             <DataTrigger.ExitActions>
                                                 <RemoveStoryboard BeginStoryboardName="SyncSpinStoryboard"/>
                                             </DataTrigger.ExitActions>
                                         </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </TextBlock.Style>
                         </TextBlock>
                     </Button>

                    <Button Command="{Binding ConnectDemoCommand}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource TechnoOrange}" CornerRadius="8" Padding="20,10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#E65100" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="PLAY" Foreground="White" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Start All Streams" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- CAMERA GRID / EMPTY STATE -->
            <Grid Grid.Row="1" Margin="15,0,15,15">
                <ItemsControl ItemsSource="{Binding CameraGrid}"
                               Visibility="{Binding ShowEmptyLiveState, Converter={StaticResource InverseBoolToVisConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding DataContext.GridRows, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                          Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/> 
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TileRoot" Style="{StaticResource LiveTileStyle}" 
                                    MouseLeftButtonDown="CameraGrid_MouseLeftButtonDown"
                                    MouseEnter="TileRoot_MouseEnter"
                                    MouseLeave="TileRoot_MouseLeave"
                                    MouseMove="TileRoot_MouseMove">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- VIDEO LAYER -->
                                <Grid Grid.Row="0" ClipToBounds="True" Background="#020617"
                                      MouseEnter="TileRoot_MouseEnter"
                                      MouseLeave="TileRoot_MouseLeave"
                                      MouseMove="TileRoot_MouseMove">

                                    <Grid Visibility="{Binding IsPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          MouseEnter="TileRoot_MouseEnter"
                                          MouseLeave="TileRoot_MouseLeave"
                                          MouseMove="TileRoot_MouseMove">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#020617" Offset="0"/>
                                                <GradientStop Color="#0F172A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border Width="68" Height="68" CornerRadius="34" Background="#0F172A" HorizontalAlignment="Center">
                                                <TextBlock Text="NO" FontSize="20" FontWeight="Bold" Foreground="#64748B"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="NO SIGNAL"
                                                       Margin="0,14,0,4"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="#CBD5E1"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Camera slot is idle"
                                                       FontSize="10"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid x:Name="NoSignalOverlay"
                                          Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBoolToVisConverter}}"
                                          MouseEnter="TileRoot_MouseEnter"
                                          MouseLeave="TileRoot_MouseLeave"
                                          MouseMove="TileRoot_MouseMove">
                                        <Grid Background="#050816">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.9">
                                                <Path x:Name="OverlayIcon" Stretch="Uniform" Width="48" Height="48" HorizontalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 0 0 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM19 18H6c-2.21 0-4-1.79-4-4 0-2.05 1.53-3.76 3.56-3.97l1.07-.11.5-.95A5.99 5.99 0 0 1 12 6c2.62 0 4.88 1.86 5.81 4.43l.48 1.34 1.37.27c2.09.41 3.23 2.65 2.22 4.63-.49.97-1.5 1.33-2.88 1.33z"/>
                                                            <Setter Property="Fill" Value="#94A3B8"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStreamFailed}" Value="True">
                                                                    <Setter Property="Data" Value="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock x:Name="OverlayText" FontSize="11" FontWeight="Bold" Margin="0,15,0,5" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="NO SIGNAL"/>
                                                            <Setter Property="Foreground" Value="#CBD5E1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStreamFailed}" Value="True">
                                                                    <Setter Property="Text" Value="SIGNAL LOST"/>
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border x:Name="OverlayBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,4" CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E2E8F0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStreamFailed}" Value="True">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock x:Name="OverlayBadgeText" FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="OFFLINE"/>
                                                            <Setter Property="Foreground" Value="#CBD5E1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStreamFailed}" Value="True">
                                                                    <Setter Property="Text" Value="ERROR"/>
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <wv2:WebView2 x:Name="WebRtcSurface"
                                                  MinWidth="64"
                                                  MinHeight="64"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  Visibility="{Binding IsWebRtcActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  MouseEnter="TileRoot_MouseEnter"
                                                  MouseLeave="TileRoot_MouseLeave"
                                                  MouseMove="TileRoot_MouseMove"
                                                  IsVisibleChanged="WebRtcSurface_IsVisibleChanged"/>

                                    <controls:VideoCanvas x:Name="VideoSurface"
                                                          MinWidth="64"
                                                          MinHeight="64"
                                                          DataContext="{Binding}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"
                                                          Visibility="{Binding IsGStreamerActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                          MouseEnter="TileRoot_MouseEnter"
                                                          MouseLeave="TileRoot_MouseLeave"
                                                          MouseMove="TileRoot_MouseMove"
                                                          NativeMouseEnter="VideoSurface_NativeMouseEnter"
                                                          NativeMouseMove="VideoSurface_NativeMouseMove"
                                                          NativeMouseLeave="VideoSurface_NativeMouseLeave"
                                                          IsVisibleChanged="VideoSurface_IsVisibleChanged"/>

                                     <!-- NO POPUPS - USING NATIVE GST OVERLAY FOR STABILITY -->

                                </Grid>
                            </Grid>
                        </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Popup x:Name="TileOverlayPopup"
                       Placement="Custom"
                       CustomPopupPlacementCallback="TileActionPopup_Placement"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       PlacementTarget="{Binding ElementName=LiveViewRoot}"
                       IsOpen="False">
                    <Border Background="#CC050816"
                            CornerRadius="10"
                            Padding="10,8"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            MouseEnter="TileOverlay_MouseEnter"
                            MouseLeave="TileOverlay_MouseLeave">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button ToolTip="Snapshot"
                                        Click="SnapshotButton_Click"
                                        Style="{StaticResource LiveOverlayButtonStyle}"
                                        Margin="0,0,4,0">
                                <Path Data="M4,7H7L8.5,5H15.5L17,7H20C21.1,7 22,7.9 22,9V18C22,19.1 21.1,20 20,20H4C2.9,20 2,19.1 2,18V9C2,7.9 2.9,7 4,7ZM12,9A4,4 0 1 0 12,17A4,4 0 1 0 12,9Z"
                                      Fill="White" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button ToolTip="Full Window"
                                        Click="FullScreenButton_Click"
                                        Style="{StaticResource LiveOverlayButtonStyle}"
                                        Margin="0,0,4,0">
                                <Path Data="M5,10V5H10 M19,10V5H14 M5,14V19H10 M19,14V19H14"
                                      Stroke="White" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Button>
                                <Button ToolTip="Reconnect Stream"
                                        Click="ReconnectButton_Click"
                                        Style="{StaticResource LiveOverlayButtonStyle}"
                                        Margin="0,0,4,0">
                                <Path Data="M18,6V10H14 M6,18V14H10 M7,7A8,8 0 1 1 7,17"
                                      Stroke="White" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Button>
                                <Button ToolTip="More Options"
                                        Style="{StaticResource LiveOverlayButtonStyle}"
                                        Margin="0"
                                        Click="MoreOptionsButton_Click">
                                <Grid Width="12" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="2.5" Height="2.5" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <Ellipse Width="2.5" Height="2.5" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="2.5" Height="2.5" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                </Grid>
                                    <Button.ContextMenu>
                                        <ContextMenu Opened="MoreOptionsMenu_Opened"
                                                     Closed="MoreOptionsMenu_Closed">
                                            <MenuItem Header="Camera Details" Click="CameraDetailsMenuItem_Click"/>
                                            <MenuItem Header="Open Playback" Click="OpenPlaybackMenuItem_Click"/>
                                            <MenuItem Header="Copy RTSP URL" Click="CopyRtspMenuItem_Click"/>
                                            <MenuItem Header="Stream Info" Click="StreamInfoMenuItem_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>

                <Border Background="#F8FBFF"
                        BorderBrush="#D8E4F0"
                        BorderThickness="1"
                        CornerRadius="18"
                        Visibility="{Binding ShowEmptyLiveState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="3" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                        <Border Width="88" Height="88" CornerRadius="44" Background="#E0F2FE" HorizontalAlignment="Center">
                            <TextBlock Text="!" FontSize="28" FontWeight="Bold" Foreground="#0284C7"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No live streams running"
                                   Margin="0,18,0,6"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Cameras are loaded, but none are currently streaming. Use Sync to refresh statuses or Start All Streams to bring cameras online."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#64748B"
                                   FontSize="13"
                                   Margin="0,0,0,22"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding SyncCommand}"
                                    Style="{StaticResource LiveActionButtonStyle}"
                                    Margin="0,0,10,0"
                                    ToolTip="Sync Status">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x21BB;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sync Status" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ConnectDemoCommand}"
                                    Content="Start All Streams"
                                    Style="{StaticResource LiveActionButtonStyle}"
                                    Background="{StaticResource TechnoOrange}"
                                    Foreground="White"
                                    BorderBrush="{StaticResource TechnoOrange}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- PAGINATION FOOTER -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button Command="{Binding PreviousPageCommand}" Width="40" Height="40" Background="White" BorderThickness="1" BorderBrush="#E2E8F0" Cursor="Hand" ToolTip="Previous Page">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="&lt;" FontSize="16" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                
                <TextBlock Text="{Binding CurrentPageDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" Margin="20,0"/>
                
                <Button Command="{Binding NextPageCommand}" Width="40" Height="40" Background="White" BorderThickness="1" BorderBrush="#E2E8F0" Cursor="Hand" ToolTip="Next Page">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text=">" FontSize="16" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>


        <Border x:Name="FullScreenLoadingOverlay"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#CC020617"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24,18"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="220"
                             Height="4"
                             IsIndeterminate="True"
                             Foreground="{StaticResource TechnoOrange}"
                             Background="#1E293B"
                             BorderThickness="0"/>
                <TextBlock Text="Loading fullscreen..."
                           Margin="0,12,0,0"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid x:Name="FullScreenGrid"
              Visibility="Collapsed"
              Background="#020617"
              ClipToBounds="True"
              Opacity="0">

            <Border Background="#020617"/>

            <Border x:Name="FullScreenCurtain"
                    Background="#020617"
                    Opacity="1"
                    IsHitTestVisible="False"/>

            <controls:VideoCanvas x:Name="FullScreenPlayer"
                                  MinWidth="64"
                                  MinHeight="64"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  IsVisibleChanged="FullScreenPlayer_IsVisibleChanged"/>

            <!-- STABLE EXIT BUTTON (TOP-LEFT) - NO POPUP TO PREVENT GHOSTING -->
            <Button VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20"
                    Command="{Binding ExitFullScreenCommand}"
                    Width="40" Height="40" Cursor="Hand"
                    Visibility="{Binding IsFullScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border CornerRadius="20" Background="#EE4444" BorderBrush="White" BorderThickness="1">
                    <TextBlock Text="X" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                </Border>
            </Button>
        </Grid>

    </Grid>
</UserControl>
