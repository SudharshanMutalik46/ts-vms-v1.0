<Window x:Class="TSVmsDesktop.Views.ManualAdoptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Camera Configuration" Height="400" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F7FA">
    <Border Padding="25">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="Manual Configuration" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,5"/>
            <TextBlock Text="ONVIF handshake failed. Enter details manually." FontSize="12" Foreground="#888" Margin="0,0,0,20"/>

            <TextBlock Text="RTSP URL" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtUrl" Height="35" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,15" Text="rtsp://192.168.1.127:554/stream"/>

            <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtUsername" Height="35" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,15" Text="admin"/>

            <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtPassword" Height="35" Padding="10,0" FontSize="14" VerticalContentAlignment="Center" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,25"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Width="80" Height="35" Margin="0,0,10,0" Background="White" BorderBrush="#DDD" BorderThickness="1" Foreground="#555" Cursor="Hand"/>
                <Button Content="Save Camera" Click="Save_Click" IsDefault="True" Width="120" Height="35" Style="{StaticResource PillButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
