<Window x:Class="TSVmsDesktop.Views.CreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create User" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="New User" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <TextBlock Text="Email"/>
        <TextBox x:Name="TxtEmail" Height="30" Margin="0,0,0,10"/>
        
        <TextBlock Text="Password"/>
        <TextBox x:Name="TxtPassword" Height="30" Margin="0,0,0,20"/>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Width="80" Height="30" Margin="0,0,10,0"/>
            <Button Content="Create" Click="Create_Click" Width="80" Height="30" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
