<Window x:Class="TSVmsDesktop.Views.CreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create User" Height="320" Width="420" WindowStartupLocation="CenterScreen"
        Background="#171717">
    <StackPanel Margin="20">
        <TextBlock Text="New User" FontSize="22" FontWeight="Bold" Foreground="#F2F2F2" Margin="0,0,0,25"/>
        
        <TextBlock Text="Email" Foreground="#B8B8BC" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtEmail" Height="38" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,15"/>
        
        <TextBlock Text="Password" Foreground="#B8B8BC" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtPassword" Height="38" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,25"/>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Width="90" Height="38" Margin="0,0,12,0" 
                    Style="{StaticResource OutlineButtonStyle}" Foreground="#B8B8BC" BorderBrush="#4A4A4F"/>
            <Button Content="Create" Click="Create_Click" Width="100" Height="38" Style="{StaticResource PillButtonStyle}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
