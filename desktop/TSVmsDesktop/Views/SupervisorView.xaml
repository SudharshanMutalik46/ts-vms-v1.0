<UserControl x:Class="TSVmsDesktop.Views.SupervisorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="20" Background="{StaticResource PageBackground}">
        <StackPanel>
            <TextBlock Text="Supervisor Console"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#F2F2F2"
                       Margin="0,0,0,6"/>
            <TextBlock Text="Windows Service Integration &amp; Diagnostics"
                       Foreground="#B8B8BC"
                       Margin="0,0,0,24"/>

            <Border Background="#2B2B2E"
                    BorderBrush="#4A4A4F"
                    BorderThickness="1"
                    Padding="18"
                    CornerRadius="18"
                    Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="System Health"
                                   FontWeight="SemiBold"
                                   Foreground="#F2F2F2"/>
                        <TextBlock Text="{Binding HealthStatus}"
                                   FontSize="18"
                                   Foreground="{StaticResource TechnoOrange}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding LastCheck, StringFormat='Last Check: {0:HH:mm:ss}'}"
                                   FontSize="11"
                                   Foreground="#B8B8BC"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding CopyDiagnosticsCommand}"
                                Content="Copy Diagnostics"
                                Style="{StaticResource OutlineButtonStyle}"
                                Height="40"
                                Margin="0,0,10,0"/>
                        <Button Command="{Binding CheckHealthCommand}"
                                Content="Refresh"
                                Style="{StaticResource OutlineButtonStyle}"
                                Height="40"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Quick Actions"
                       FontWeight="SemiBold"
                       Foreground="#F2F2F2"
                       Margin="0,0,0,12"/>

            <UniformGrid Columns="2" Margin="0,0,0,20">
                <Button Command="{Binding OpenLogsCommand}"
                        Content="Open Logs Folder"
                        Height="44"
                        Margin="0,0,12,0"
                        Style="{StaticResource OutlineButtonStyle}"/>
                <Button Command="{Binding OpenEventViewerCommand}"
                        Content="Open Event Viewer"
                        Height="44"
                        Style="{StaticResource OutlineButtonStyle}"/>
            </UniformGrid>

            <TextBlock Text="Raw Health Payload"
                       FontWeight="SemiBold"
                       Foreground="#F2F2F2"
                       Margin="0,0,0,10"/>

            <Border Background="#3A3A3D"
                    BorderBrush="#4A4A4F"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10">
                <TextBox Text="{Binding Details}"
                         Height="220"
                         FontFamily="Consolas"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#F2F2F2"
                         TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
