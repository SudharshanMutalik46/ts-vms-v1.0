<UserControl x:Class="TSVmsDesktop.Views.SupervisorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Supervisor Console" FontSize="24" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Windows Service Integration &amp; Diagnostics" Foreground="#777" Margin="0,0,0,20"/>

            <Border Background="White" Padding="20" CornerRadius="8" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="System Health" FontWeight="Bold"/>
                        <TextBlock Text="{Binding HealthStatus}" FontSize="18" Foreground="{DynamicResource TechnoOrange}"/>
                        <TextBlock Text="{Binding LastCheck, StringFormat='Last Check: {0:HH:mm:ss}'}" FontSize="11" Foreground="#999"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding CopyDiagnosticsCommand}" Content="Copy Diagnostics" Margin="0,0,10,0" Padding="10,5"/>
                        <Button Command="{Binding CheckHealthCommand}" Content="Refresh" Padding="10,5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Quick Actions" FontWeight="Bold" Margin="0,0,0,10"/>
            <UniformGrid Columns="3">
                <Button Command="{Binding OpenLogsCommand}" Content="Open Logs Folder" Height="50" Margin="0,0,10,0" Background="White" BorderBrush="#DDD" BorderThickness="1"/>
                <Button Command="{Binding OpenEventViewerCommand}" Content="Open Event Viewer" Height="50" Margin="0,0,10,0" Background="White" BorderBrush="#DDD" BorderThickness="1"/>
            </UniformGrid>

            <TextBlock Text="Raw Health Payload" FontWeight="Bold" Margin="0,20,0,5"/>
            <TextBox Text="{Binding Details}" Height="200" FontFamily="Consolas" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </Grid>
</UserControl>
