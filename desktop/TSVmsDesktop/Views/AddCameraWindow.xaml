<Window x:Class="TSVmsDesktop.Views.AddCameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Camera"
        Height="680"
        Width="500"
        MinHeight="650"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#171717"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DialogFieldStyle" TargetType="TextBox" BasedOn="{StaticResource ModernInputStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#4A4A4F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FF8A1F"/>
        </Style>

        <Style x:Key="DialogPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#4A4A4F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="DialogHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B8B8BC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,-2,0,12"/>
        </Style>

        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>

        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#4A4A4F"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border Background="#2B2B2E" CornerRadius="20" Padding="24">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="24" ShadowDepth="4" Opacity="0.16"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Add New Camera" FontSize="38" FontWeight="Bold" Foreground="#F2F2F2"/>
                    <TextBlock Text="Capture the stream endpoint and optional credentials in one step."
                               FontSize="12" Foreground="#B8B8BC" Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Height="1" Background="#3E3E42" Margin="0,0,0,14"/>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Camera Name" Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox x:Name="TxtName" Style="{StaticResource DialogFieldStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="RTSP Stream URL" Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox x:Name="TxtUrl" Style="{StaticResource DialogFieldStyle}" Text="rtsp://"/>
                        <TextBlock Text="Format: rtsp://user:pass@ip:port/path" Style="{StaticResource DialogHintStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="IP Address (Optional)" Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox x:Name="TxtIp" Style="{StaticResource DialogFieldStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <TextBlock Text="Username (Optional)" Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox x:Name="TxtUsername" Style="{StaticResource DialogFieldStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="Password (Optional)" Style="{StaticResource DialogLabelStyle}"/>
                        <PasswordBox x:Name="TxtPassword" Style="{StaticResource DialogPasswordStyle}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogSecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Save Camera" Click="Save_Click" IsDefault="True" Style="{StaticResource DialogPrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
