<Window x:Class="TSVmsDesktop.Views.AddCameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Camera" Height="450" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F7FA">

    <Border Padding="25">
        <StackPanel>
            <TextBlock Text="Add New Camera" FontSize="22" FontWeight="Bold" Foreground="#333" Margin="0,0,0,25"/>

            <TextBlock Text="Camera Name" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtName" Height="40" Padding="10,0" FontSize="14" VerticalContentAlignment="Center"
                     BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,20"/>

            <TextBlock Text="RTSP Stream URL" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtUrl" Height="40" Padding="10,0" FontSize="14" VerticalContentAlignment="Center"
                     BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,5"
                     Text="rtsp://"/>
            <TextBlock Text="Format: rtsp://user:pass@ip:554/stream" FontSize="12" Foreground="#999" Margin="0,0,0,20"/>

            <TextBlock Text="IP Address (Optional)" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtIp" Height="40" Padding="10,0" FontSize="14" VerticalContentAlignment="Center"
                     BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Width="100" Height="40" Margin="0,0,10,0" Cursor="Hand"
                        Background="White" BorderBrush="#DDD" BorderThickness="1" Foreground="#555"/>
                
                <Button Content="Save Camera" Click="Save_Click" IsDefault="True" Width="130" Height="40" Cursor="Hand"
                        Background="#E65100" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
