<UserControl x:Class="TSVmsDesktop.Views.WindowsDiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30" Background="{StaticResource PageBackground}">
        <StackPanel>
            <TextBlock Text="Windows Discovery Helper"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#F2F2F2"
                       Margin="0,0,0,24"/>

            <Border Background="#193126"
                    BorderBrush="#31C776"
                    BorderThickness="1"
                    Padding="16"
                    CornerRadius="14"
                    Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="Troubleshooting Checklist"
                               FontWeight="SemiBold"
                               Foreground="#31C776"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="• Ensure the backend is running as Administrator."
                               Foreground="#F2F2F2"/>
                    <TextBlock Text="• Check Windows Firewall allows UDP Port 3702 (WS-Discovery)."
                               Foreground="#F2F2F2"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="• Ensure network profile is set to 'Private' not 'Public'."
                               Foreground="#F2F2F2"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Button Command="{Binding RunScanCommand}"
                    Content="Run Diagnostics Scan"
                    Style="{StaticResource PillButtonStyle}"
                    Width="200"
                    Height="42"
                    HorizontalAlignment="Left"/>

            <TextBlock Text="Scan Results:"
                       FontWeight="SemiBold"
                       Foreground="#F2F2F2"
                       Margin="0,22,0,10"/>

            <Border Background="#3A3A3D"
                    BorderBrush="#4A4A4F"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10">
                <TextBox Text="{Binding ScanResult}"
                         Height="220"
                         FontFamily="Consolas"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#F2F2F2"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
