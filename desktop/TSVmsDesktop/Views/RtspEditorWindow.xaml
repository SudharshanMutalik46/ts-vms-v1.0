<Window x:Class="TSVmsDesktop.Views.RtspEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update RTSP Settings"
        Width="640"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#EEF3F9"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="DialogFieldStyle" TargetType="TextBox" BasedOn="{StaticResource ModernInputStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="DialogComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>

        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="DialogHintStyle">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Background="White" CornerRadius="22" Padding="26">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="24" ShadowDepth="4" Opacity="0.16"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Update RTSP Settings"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#1E293B"/>
                    <TextBlock Text="Edit the stream URL, camera credentials, and main/sub profile mapping."
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="RTSP Stream URL" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtRtspUrl"
                                 Style="{StaticResource DialogFieldStyle}"
                                 Text="rtsp://"/>
                        <TextBlock Text="Use the full RTSP URL, including the path required by the camera."
                                   Style="{StaticResource DialogHintStyle}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Port" FontWeight="SemiBold" Foreground="#334155" Margin="0,4,0,6"/>
                        <TextBox x:Name="TxtPort"
                                 Style="{StaticResource DialogFieldStyle}"
                                 Text="554"/>
                        <TextBlock Text="Leave blank to keep the current camera port."
                                   Style="{StaticResource DialogHintStyle}"
                                   Margin="0,0,0,10"/>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,4,0,14">
                            <StackPanel>
                                <TextBlock Text="Camera Credentials" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="These credentials are saved for stream access."
                                           Style="{StaticResource DialogHintStyle}"
                                           Margin="0,4,0,14"/>

                                <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtUsername" Style="{StaticResource DialogFieldStyle}"/>

                                <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#334155" Margin="0,4,0,6"/>
                                <PasswordBox x:Name="TxtPassword"
                                             Height="40"
                                             Padding="10,0"
                                             FontSize="14"
                                             VerticalContentAlignment="Center"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1"
                                             Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Main / Sub Stream Profiles" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Pick the media profiles to use for main and sub stream selection."
                                           Style="{StaticResource DialogHintStyle}"
                                           Margin="0,4,0,14"/>

                                <TextBlock Text="Main Stream" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbMainProfile"
                                          Style="{StaticResource DialogComboStyle}"
                                          DisplayMemberPath="Name"/>

                                <TextBlock Text="Sub Stream" FontWeight="SemiBold" Foreground="#334155" Margin="0,4,0,6"/>
                                <ComboBox x:Name="CmbSubProfile"
                                          Style="{StaticResource DialogComboStyle}"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    IsCancel="True"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    Margin="0,0,10,0"/>
                            <Button Content="Save Changes"
                                    Click="Save_Click"
                                    IsDefault="True"
                                    Style="{StaticResource DialogPrimaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
