<Window x:Class="TSVmsDesktop.Views.RtspEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update RTSP Settings"
        Width="640"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#171717"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="DialogFieldStyle" TargetType="TextBox" BasedOn="{StaticResource ModernInputStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#4A4A4F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FF8A1F"/>
        </Style>

        <Style x:Key="DialogComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#4A4A4F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>

        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#4A4A4F"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="DialogHintStyle">
            <Setter Property="Foreground" Value="#B8B8BC"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Background="#2B2B2E" CornerRadius="22" Padding="26">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="24" ShadowDepth="4" Opacity="0.16"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Update RTSP Settings"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#F2F2F2"/>
                    <TextBlock Text="Edit the main and sub RTSP URLs plus camera credentials."
                               FontSize="12"
                               Foreground="#B8B8BC"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Current / Old RTSP URL" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtCurrentRtspUrl"
                                 Style="{StaticResource DialogFieldStyle}"
                                 Text="rtsp://"/>
                        <TextBlock Text="This is the camera base RTSP URL used for fallback and credentials."
                                   Style="{StaticResource DialogHintStyle}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Main Stream RTSP URL" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtMainRtspUrl"
                                 Style="{StaticResource DialogFieldStyle}"
                                 Text="rtsp://"/>
                        <TextBlock Text="Use this for full-screen and primary playback."
                                   Style="{StaticResource DialogHintStyle}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Sub Stream RTSP URL" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,4,0,6"/>
                        <TextBox x:Name="TxtSubRtspUrl"
                                 Style="{StaticResource DialogFieldStyle}"
                                 Text="rtsp://"/>
                        <TextBlock Text="Use this for the tiled live view grid."
                                   Style="{StaticResource DialogHintStyle}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Port" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,4,0,6"/>
                        <TextBox x:Name="TxtPort"
                                 Style="{StaticResource DialogFieldStyle}"
                                 Text="554"/>
                        <TextBlock Text="Leave blank to keep the current camera port."
                                   Style="{StaticResource DialogHintStyle}"
                                   Margin="0,0,0,10"/>

                        <Border Background="#3A3A3D" BorderBrush="#4A4A4F" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,4,0,14">
                            <StackPanel>
                                <TextBlock Text="Camera Credentials" FontSize="16" FontWeight="Bold" Foreground="#F2F2F2"/>
                                <TextBlock Text="These credentials are saved for stream access."
                                           Style="{StaticResource DialogHintStyle}"
                                           Margin="0,4,0,14"/>

                                <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtUsername" Style="{StaticResource DialogFieldStyle}"/>

                                <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,4,0,6"/>
                                <PasswordBox x:Name="TxtPassword"
                                             Height="40"
                                             Padding="10,0"
                                             FontSize="14"
                                             VerticalContentAlignment="Center"
                                             Background="#3A3A3D"
                                             Foreground="#F2F2F2"
                                             BorderBrush="#4A4A4F"
                                             BorderThickness="1"
                                             Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    IsCancel="True"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    Margin="0,0,10,0"/>
                            <Button Content="Save Changes"
                                    Click="Save_Click"
                                    IsDefault="True"
                                    Style="{StaticResource DialogPrimaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
