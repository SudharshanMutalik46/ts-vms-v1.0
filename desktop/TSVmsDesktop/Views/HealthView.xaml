<UserControl x:Class="TSVmsDesktop.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel Margin="0,0,0,20">
                
                <Grid Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="System Health" FontSize="26" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="Real-time monitoring of local services" FontSize="14" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <Button Command="{Binding ExportLogsCommand}" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{StaticResource TechnoOrange}" CornerRadius="20" Padding="25,10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#E65100" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⬇" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" FontSize="14"/>
                                        <TextBlock Text="Export Logs" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                        <Setter TargetName="btnBorder" Property="Background" Value="#CC4600"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Border Background="White" CornerRadius="15" Margin="0,0,0,25" Padding="30">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDD" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Grid Width="60" Height="60">
                             <Border CornerRadius="30" Background="{Binding StatusColor}" Opacity="0.15"/>
                             <Ellipse Width="24" Height="24" Fill="{Binding StatusColor}"/>
                        </Grid>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="Last Pulse: " Foreground="#999"/>
                                <TextBlock Text="{Binding LastCheck, StringFormat='HH:mm:ss'}" Foreground="#666" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Service Status" FontSize="16" FontWeight="Bold" Foreground="#444" Margin="5,0,0,15"/>
                
                <ItemsControl ItemsSource="{Binding BackendServices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" Margin="6" Padding="20" CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect Color="#E0E0E0" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                                </Border.Effect>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        <TextBlock Text="{Binding Name}" Foreground="#444" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Status}" Foreground="#888" FontSize="13" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        
                                        <Button Command="{Binding DataContext.CheckHealthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Cursor="Hand" Background="Transparent" BorderThickness="0">
                                            <Border Background="#F5F5F5" Width="30" Height="30" CornerRadius="15">
                                                <TextBlock Text="↻" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAA" FontWeight="Bold" Margin="0,-2,0,0"/>
                                            </Border>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.7"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="API Raw Heartbeat" FontSize="16" FontWeight="Bold" Foreground="#444" Margin="5,30,0,15"/>
                <Border Background="#F8F9FA" CornerRadius="10" BorderBrush="#EAEAEA" BorderThickness="1" Padding="15">
                     <TextBox Text="{Binding JsonDetails}" IsReadOnly="True" Height="150" Background="Transparent" 
                             BorderThickness="0" Foreground="#555" FontFamily="Consolas" TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
