<UserControl x:Class="TSVmsDesktop.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel Margin="0,0,0,12">

                <Grid Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="System Health" FontSize="34" FontWeight="Bold" Foreground="#F2F2F2"/>
                        <TextBlock Text="Real-time monitoring of local services" FontSize="14" Foreground="#B8B8BC" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Command="{Binding ExportLogsCommand}" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{StaticResource TechnoOrange}" CornerRadius="18" Padding="20,8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#E65100" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0" FontSize="12"/>
                                        <TextBlock Text="Export Logs" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                        <Setter TargetName="btnBorder" Property="Background" Value="#CC4600"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Border Background="#2B2B2E" BorderBrush="#4A4A4F" BorderThickness="1" CornerRadius="14" Margin="0,0,0,16" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="#111827" BlurRadius="14" ShadowDepth="2" Opacity="0.2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="52" Height="52">
                            <Border CornerRadius="26" Background="{Binding StatusColor}" Opacity="0.14"/>
                            <Ellipse Width="20" Height="20" Fill="{Binding StatusColor}"/>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="18" FontWeight="Bold" Foreground="#F2F2F2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Last Pulse: " Foreground="#B8B8BC"/>
                                <TextBlock Text="{Binding LastCheck, StringFormat='HH:mm:ss'}" Foreground="#F2F2F2" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Service Status" FontSize="16" FontWeight="Bold" Foreground="#F2F2F2" Margin="4,0,0,10"/>

                <ItemsControl ItemsSource="{Binding BackendServices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2B2B2E" BorderBrush="#4A4A4F" BorderThickness="1" Margin="4" Padding="14,12" CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#111827" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" Foreground="#F2F2F2" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Status}" Foreground="#B8B8BC" FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                        <Button Command="{Binding DataContext.CheckHealthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Cursor="Hand" Background="Transparent" BorderThickness="0">
                                            <Border Background="#3A3A3D" BorderBrush="#4A4A4F" BorderThickness="1" Width="28" Height="28" CornerRadius="14">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B8B8BC"/>
                                            </Border>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.7"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Recording Engine Telemetry" FontSize="16" FontWeight="Bold" Foreground="#F2F2F2" Margin="4,16,0,10"/>

                <Border Background="#2B2B2E" BorderBrush="#4A4A4F" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,4,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#111827" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Active Recordings" FontSize="12" Foreground="#B8B8BC" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveRecordingsCount}" FontSize="36" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="#3A3A3D" Margin="12,2"/>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Storage I/O" FontSize="12" Foreground="#B8B8BC" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding DiskWriteRate}" FontSize="36" FontWeight="Bold" Foreground="{Binding EngineStateColor}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="3" Width="1" Background="#3A3A3D" Margin="12,2"/>

                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <TextBlock Text="Stream Stability" FontSize="12" Foreground="#B8B8BC" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding GlobalFrameDropRate}" FontSize="26" FontWeight="SemiBold" Foreground="{Binding EngineStateColor}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="API Raw Heartbeat" FontSize="16" FontWeight="Bold" Foreground="#F2F2F2" Margin="4,14,0,10"/>
                <Border Background="#3A3A3D" CornerRadius="10" BorderBrush="#4A4A4F" BorderThickness="1" Padding="12">
                     <TextBox Text="{Binding JsonDetails}" IsReadOnly="True" Height="150" Background="Transparent" 
                             BorderThickness="0" Foreground="#F2F2F2" FontFamily="Consolas" TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
