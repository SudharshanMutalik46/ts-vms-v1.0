<Window x:Class="TSVmsDesktop.Views.CredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Credentials" Height="356" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DialogPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#4A4A4F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Border Padding="12" Background="Transparent">
        <Border Background="#171717" CornerRadius="16" BorderBrush="#4A4A4F" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.32"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#202125" Height="46" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Camera Credentials"
                               Foreground="#F2F2F2"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <Button Grid.Column="1"
                            Width="36"
                            Height="30"
                            Margin="0,8,8,8"
                            Content="✕"
                            Click="Close_Click"
                            Background="Transparent"
                            Foreground="#D4D4D8"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>

                <Border Grid.Row="1" Background="#2E3035" Height="1"/>

                <Border Grid.Row="2" Padding="22,18,22,16" Background="#2B2B2E" CornerRadius="0,0,16,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TxtTitle" Grid.Row="0" Text="Device Authentication" FontSize="20" FontWeight="Bold" Foreground="#F2F2F2"/>
                        <TextBlock Grid.Row="1" Text="Enter the camera's ONVIF credentials." FontSize="12" Foreground="#B8B8BC" Margin="0,6,0,16"/>

                        <TextBlock Grid.Row="2" Text="Username" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="3" x:Name="TxtUsername" Height="40" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,12" Text="admin"/>

                        <TextBlock Grid.Row="4" Text="Password" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,0,0,6"/>
                        <PasswordBox Grid.Row="5" x:Name="TxtPassword" Style="{StaticResource DialogPasswordBoxStyle}" Margin="0,0,0,18"/>

                        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" IsCancel="True" Style="{StaticResource OutlineButtonStyle}" Width="96" Height="38" Margin="0,0,10,0"/>
                            <Button Content="Adopt Camera" Click="Adopt_Click" IsDefault="True" Style="{StaticResource PillButtonStyle}" Width="132" Height="38"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
