<Window x:Class="TSVmsDesktop.Views.CredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Credentials" Height="320" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#171717"
        WindowStyle="SingleBorderWindow">
    <Border Padding="26">
        <Border Background="#2B2B2E" CornerRadius="22" Padding="22">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.2"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="Device Authentication" FontSize="20" FontWeight="Bold" Foreground="#F2F2F2" Margin="0,0,0,6"/>
                <TextBlock Text="Enter the camera's ONVIF credentials." FontSize="12" Foreground="#B8B8BC" Margin="0,0,0,20"/>

                <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUsername" Height="40" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,15" Text="admin"/>

                <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtPassword" Height="40" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" 
                             Background="#3A3A3D" Foreground="#F2F2F2" BorderBrush="#4A4A4F" BorderThickness="1" Margin="0,0,0,25"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Style="{StaticResource OutlineButtonStyle}" Width="90" Height="40" Margin="0,0,10,0"/>
                    <Button Content="Adopt Camera" Click="Adopt_Click" IsDefault="True" Style="{StaticResource PillButtonStyle}" Width="130" Height="40"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>
