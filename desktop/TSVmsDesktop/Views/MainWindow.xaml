<Window x:Class="TSVmsDesktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TSVmsDesktop.ViewModels"
        xmlns:views="clr-namespace:TSVmsDesktop.Views"
        xmlns:converters="clr-namespace:TSVmsDesktop.Converters"
        Title="{Binding WindowTitle}" Height="800" Width="1400"
        Background="{StaticResource PageBackground}"
        Closing="Window_Closing" Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}"><views:StartupView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HealthViewModel}"><views:HealthView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LiveViewModel}"><views:LiveView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CamerasViewModel}"><views:CamerasView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}"><views:AuditView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LicenseViewModel}"><views:LicenseView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}"><views:UsersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupervisorViewModel}"><views:SupervisorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OnvifDiscoveryViewModel}"><views:OnvifDiscoveryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CameraDetailsViewModel}"><views:CameraDetailsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NvrsViewModel}"><views:NvrsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NvrDetailsViewModel}"><views:NvrDetailsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WindowsDiscoveryViewModel}"><views:WindowsDiscoveryView/></DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateToLiveCommand}"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateToCamerasCommand}"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateToHealthCommand}"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateToSettingsCommand}"/>
    </Window.InputBindings>




    <Grid>
        <ContentControl Content="{Binding CurrentView}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="25"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKioskMode}" Value="True">
                             <Setter Property="Margin" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="15" Height="90" Margin="0,0,0,25"
                    Visibility="{Binding IsKioskMode, Converter={StaticResource InverseBoolToVisConverter}}">
                <Border.Effect>
                    <DropShadowEffect Color="#DDD" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="*"/>    <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="Auto"/> </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Images/logo.png" Height="65" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,25,0">
                        <TextBox x:Name="HeaderSearchBox" 
                                 Style="{StaticResource SearchBoxStyle}" 
                                 Width="320" Height="45" 
                                 VerticalContentAlignment="Center" 
                                 Padding="45,0,10,0"
                                 FontSize="14"
                                 Foreground="#333"/>
                        
                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False" VerticalAlignment="Center" Margin="15,0,0,0">
                            <TextBlock Text="🔍" Foreground="#AAA" FontSize="16" Margin="0,1,5,0"/>
                            <TextBlock Text="Search" Foreground="#BBB" FontSize="14" VerticalAlignment="Center"/>
                            
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=HeaderSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="3" Width="45" Height="45" CornerRadius="25" Background="#F5F5F5" Cursor="Hand">
                        <TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555" FontSize="18"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="25">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="25"/>
                         <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKioskMode}" Value="True">
                                 <Setter Property="CornerRadius" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect Color="#CCC" BlurRadius="20" ShadowDepth="5" Opacity="0.15"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="320" Background="{StaticResource TechnoOrange}" CornerRadius="25,0,0,25"
                            Visibility="{Binding IsKioskMode, Converter={StaticResource InverseBoolToVisConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>    <RowDefinition Height="Auto"/> </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                                <StackPanel Margin="30,40,30,20">
                                    <TextBlock Text="Dashboard" Foreground="White" Opacity="0.9" FontSize="14" Margin="10,0,0,15"/>
                                    
                                    <Button Content="Live View" Command="{Binding NavigateToLiveCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Live">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TechnoOrange}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Margin" Value="0,5"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Effect" Value="{StaticResource SidebarShadow}"/>
                                                        <Setter Property="Template" Value="{StaticResource SidebarActiveButtonTemplate}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    
                                    <Button Content="Playback" Style="{StaticResource SidebarButtonStyle}" Opacity="0.8"/>
                                    
                                    <Button Content="Audit Log" Command="{Binding NavigateToAuditCommand}" 
                                            Visibility="{Binding CanViewAudit, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Audit Log">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TechnoOrange}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Margin" Value="0,5"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Effect" Value="{StaticResource SidebarShadow}"/>
                                                        <Setter Property="Template" Value="{StaticResource SidebarActiveButtonTemplate}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="Cameras" Command="{Binding NavigateToCamerasCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Cameras">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TechnoOrange}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Margin" Value="0,5"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Effect" Value="{StaticResource SidebarShadow}"/>
                                                        <Setter Property="Template" Value="{StaticResource SidebarActiveButtonTemplate}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="NVRs" Command="{Binding NavigateToNvrsCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentPage}" Value="NVRs">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TechnoOrange}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Margin" Value="0,5"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Effect" Value="{StaticResource SidebarShadow}"/>
                                                        <Setter Property="Template" Value="{StaticResource SidebarActiveButtonTemplate}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    
                                    <Button Content="AI Config" Style="{StaticResource SidebarButtonStyle}" Opacity="0.8"/>
                                    
                                    <Button Content="System Health" Command="{Binding NavigateToHealthCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Health">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TechnoOrange}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Margin" Value="0,5"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Effect" Value="{StaticResource SidebarShadow}"/>
                                                        <Setter Property="Template" Value="{StaticResource SidebarActiveButtonTemplate}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    
                                    <Button Content="Users" Command="{Binding NavigateToUsersCommand}" 
                                            Visibility="{Binding CanViewUsers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Users">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TechnoOrange}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Margin" Value="0,5"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Effect" Value="{StaticResource SidebarShadow}"/>
                                                        <Setter Property="Template" Value="{StaticResource SidebarActiveButtonTemplate}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="License" Command="{Binding NavigateToLicenseCommand}" 
                                            Visibility="{Binding CanViewLicense, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentPage}" Value="License">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TechnoOrange}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Margin" Value="0,5"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Effect" Value="{StaticResource SidebarShadow}"/>
                                                        <Setter Property="Template" Value="{StaticResource SidebarActiveButtonTemplate}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="Supervisor" Command="{Binding NavigateToSupervisorCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Supervisor">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TechnoOrange}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Margin" Value="0,5"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Effect" Value="{StaticResource SidebarShadow}"/>
                                                        <Setter Property="Template" Value="{StaticResource SidebarActiveButtonTemplate}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="Win Helper" Command="{Binding NavigateToWinDiscoveryCommand}" Style="{StaticResource SidebarButtonStyle}" Opacity="0.8"/>
                                    
                                    <Button Content="Settings" Command="{Binding NavigateToSettingsCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TechnoOrange}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Margin" Value="0,5"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Effect" Value="{StaticResource SidebarShadow}"/>
                                                        <Setter Property="Template" Value="{StaticResource SidebarActiveButtonTemplate}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                            
                            <StackPanel Grid.Row="1" Margin="30,0,30,40">
                                <Separator Background="White" Opacity="0.3" Margin="10,0,10,20"/>
                                <Button Content="Logout" Command="{Binding NavigateToLogoutCommand}" Style="{StaticResource SidebarButtonStyle}" Opacity="0.9"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="White" ClipToBounds="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0,25,25,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKioskMode}" Value="True">
                                        <Setter Property="CornerRadius" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid x:Name="ViewLayoutContainer">
                            <!-- Persistent Live View layer -->
                            <views:LiveView DataContext="{Binding LiveVM}">
                                <views:LiveView.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Margin" Value="20"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Live">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.IsKioskMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Margin" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:LiveView.Style>
                            </views:LiveView>

                            <!-- Other Views layer -->
                            <ContentControl Content="{Binding CurrentView}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Margin" Value="20"/>
                                        <Setter Property="Visibility" Value="Visible"/> 
                                        <Style.Triggers>
                                            <!-- Hide when showing persistent Live View -->
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="Live">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            
                                            <DataTrigger Binding="{Binding IsKioskMode}" Value="True">
                                                <Setter Property="Margin" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
