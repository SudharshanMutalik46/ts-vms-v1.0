<UserControl x:Class="TSVmsDesktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="BorderBrush" Value="#4A4A4F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource TechnoOrange}"/>
                                <Setter TargetName="border" Property="Background" Value="#444447"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#171717"/>
        </Grid.Background>

        <Border Width="1050" Height="600" CornerRadius="18" Background="#2B2B2E">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.1" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>  <ColumnDefinition Width="1*"/>    
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="70,50">
                    <StackPanel VerticalAlignment="Center">
                        <Image Source="/Images/logo.png" HorizontalAlignment="Left" Height="40" Margin="0,0,0,50"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <TextBlock Text="Sign In to VMS Dashboard" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource TechnoOrange}" Margin="0,0,0,40" 
                                   HorizontalAlignment="Center"/>

                        <Grid Margin="0,0,0,20" Height="50">
                            <TextBox Style="{StaticResource ModernInputStyle}" 
                                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     x:Name="UserBox"
                                     VerticalContentAlignment="Center" Padding="45,0,10,0"/>

                            <TextBlock Text="👤" Foreground="#BBB" FontSize="16" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>

                            <TextBlock Text="Email / Phone" IsHitTestVisible="False" Foreground="#BBB" FontSize="13" VerticalAlignment="Center" Margin="42,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=UserBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,0,0,25" Height="50">
                            <PasswordBox x:Name="SecretBox"
                                         VerticalContentAlignment="Center" Padding="45,0,40,0"
                                         PasswordChanged="SecretBox_PasswordChanged">
                                <PasswordBox.Style>
                                    <Style TargetType="PasswordBox" BasedOn="{StaticResource ModernPasswordBoxStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </PasswordBox.Style>
                            </PasswordBox>
                                         
                            <TextBox x:Name="VisibleBox"
                                     Style="{StaticResource ModernInputStyle}"
                                     Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Padding="45,0,40,0"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisConverter}}"
                                     TextChanged="VisibleBox_TextChanged"/>

                            <TextBlock Text="🔒" Foreground="#BBB" FontSize="16" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>

                            <TextBlock Text="Password" IsHitTestVisible="False" Foreground="#BBB" FontSize="13" VerticalAlignment="Center" Margin="42,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Password}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Command="{Binding TogglePasswordCommand}" 
                                    Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,10,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="👁" FontSize="16" Foreground="#BBB" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,50">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <CheckBox VerticalContentAlignment="Center" IsChecked="{Binding RememberMe}"/>
                                <TextBlock Text="Remember password" Foreground="#B8B8BC" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock Text="Forgot your password?" Foreground="#F2F2F2" HorizontalAlignment="Right" 
                                       Cursor="Hand" TextDecorations="Underline" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

                        <Button Content="SIGN IN" Command="{Binding LoginCommand}" 
                                Style="{StaticResource PillButtonStyle}" Width="160" Height="48" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource TechnoOrange}" CornerRadius="0,15,15,0" ClipToBounds="True">
                    <Grid>
                        <Image Source="/Images/background.jpg" Stretch="UniformToFill" Opacity="0.1"/>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="50">
                            <TextBlock Text="Hello, Friend!" Foreground="White" FontSize="36" FontWeight="Bold" 
                                       TextAlignment="Center" Margin="0,0,0,20"/>
                            
                            <TextBlock Text="Add your information and start your journey with us." 
                                       Foreground="White" FontSize="15" TextAlignment="Center" 
                                       TextWrapping="Wrap" Opacity="0.9" Margin="0,0,0,45" LineHeight="24"/>
                            
                            <Button Content="SIGN UP" Style="{StaticResource OutlineButtonStyle}" Width="160" Height="48"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
