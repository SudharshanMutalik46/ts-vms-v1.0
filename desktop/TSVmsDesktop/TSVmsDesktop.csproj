<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\logo.png" />
    <Resource Include="Images\background.jpg" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\webrtc_player.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyPlaybackEngineToOutputRoot" AfterTargets="Build">
    <PropertyGroup>
      <NativePlaybackEngineDll>$(MSBuildProjectDirectory)\..\..\native\TSVmsPlaybackEngine\build\$(Configuration)\TSVmsPlaybackEngine.dll</NativePlaybackEngineDll>
    </PropertyGroup>
    <Copy
      SourceFiles="$(NativePlaybackEngineDll)"
      DestinationFiles="$(MSBuildProjectDirectory)\native\win-x64\TSVmsPlaybackEngine.dll"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(NativePlaybackEngineDll)"
      DestinationFiles="$(TargetDir)TSVmsPlaybackEngine.dll"
      SkipUnchangedFiles="true" />
  </Target>


</Project>
