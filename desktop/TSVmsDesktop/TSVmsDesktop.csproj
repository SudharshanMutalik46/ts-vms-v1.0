<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\logo.png" />
    <Resource Include="Images\operator-logo.png" />
    <Resource Include="Images\operator-logo1.png" />
    <Resource Include="Images\techno_support_logo_white_match_size_699x351.png" />
    <Resource Include="Images\operator-logo-badge.png" />
    <Resource Include="Images\logout-icon.png" />
    <Resource Include="Images\background.jpg" />
    <Resource Include="Images\1 quad.png" />
    <Resource Include="Images\4 quad.png" />
    <Resource Include="Images\play.png" />
    <Resource Include="Images\pause.png" />
    <Resource Include="Images\move forward.png" />
    <Resource Include="Images\export video.png" />
    <Resource Include="Images\ui-icons\1 quad.png" />
    <Resource Include="Images\ui-icons\4 quad.png" />
    <Resource Include="Images\ui-icons\play.png" />
    <Resource Include="Images\ui-icons\pause.png" />
    <Resource Include="Images\ui-icons\move forward.png" />
    <Resource Include="Images\ui-icons\export video.png" />
    <Resource Include="Images\icons8-pause-100.png" />
    <Resource Include="Images\play_24x24.png" />
    <Resource Include="Images\play_32x32.png" />
    <Resource Include="Images\pause_32x32.png" />
    <Resource Include="Images\forward_32x32.png" />
    <Resource Include="Images\export_32x32.png" />
    <Resource Include="Images\quad1_32x32.png" />
    <Resource Include="Images\quad4_32x32.png" />
    <Resource Include="Images\step_32x32.png" />
    <Resource Include="Images\step10_32x32.png" />
    <Resource Include="Images\skip5m_32x32.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\webrtc_player.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyPlaybackEngineToOutputRoot" AfterTargets="Build">
    <PropertyGroup>
      <NativePlaybackEngineDll>$(MSBuildProjectDirectory)\..\..\native\TSVmsPlaybackEngine\build\$(Configuration)\TSVmsPlaybackEngine.dll</NativePlaybackEngineDll>
    </PropertyGroup>
    <Copy
      SourceFiles="$(NativePlaybackEngineDll)"
      DestinationFiles="$(MSBuildProjectDirectory)\native\win-x64\TSVmsPlaybackEngine.dll"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(NativePlaybackEngineDll)"
      DestinationFiles="$(TargetDir)TSVmsPlaybackEngine.dll"
      SkipUnchangedFiles="true" />
  </Target>


</Project>
